{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build:wasm": {
      "cache": true,
      "inputs": [
        "src/**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        ".cargo/**"
      ],
      "outputs": [
        "pkg/**",
        "target/wasm32-unknown-unknown/release/*.wasm"
      ],
      "env": [
        "WASM_PACK_PROFILE"
      ]
    },
    "build": {
      "dependsOn": ["^build", "^build:wasm"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "dist/**",
        "pkg/**"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_TELEMETRY_DISABLED",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev:wasm": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "^build:wasm"]
    },
    "test:rust": {
      "cache": true,
      "inputs": [
        "src/**/*.rs",
        "tests/**/*.rs",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "outputs": [
        "target/debug/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "jest.config.js",
        "jest.setup.js"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint:rust": {
      "cache": true,
      "inputs": [
        "src/**/*.rs",
        "Cargo.toml",
        "rustfmt.toml",
        "clippy.toml"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".eslintrc.json",
        "eslint.config.mjs"
      ]
    },
    "clean:wasm": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "type-check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json"
      ],
      "outputs": [
        "tsconfig.tsbuildinfo"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "RUSTFLAGS"
  ],
  "globalDependencies": [
    "tsconfig.json",
    "pnpm-workspace.yaml",
    "rust-toolchain.toml"
  ]
}
