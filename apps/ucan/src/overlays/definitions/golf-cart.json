{
  "version": "1.0",
  "name": "Golf Cart CAN",
  "description": "Custom CAN definitions for electric golf cart with brake, blinker, and lighting controls",
  "author": "ril3y",
  "created": "2025-01-15",

  "messages": [
    {
      "id": "0x100",
      "name": "Body Control",
      "description": "Brake, blinkers, and lighting status",
      "dlc": 1,
      "cycleTime": 100,
      "fields": [
        {
          "name": "brake_pressed",
          "description": "Brake pedal pressed",
          "byteOffset": 0,
          "bitOffset": 0,
          "bitLength": 1,
          "type": "boolean"
        },
        {
          "name": "left_blinker",
          "description": "Left turn signal active",
          "byteOffset": 0,
          "bitOffset": 1,
          "bitLength": 1,
          "type": "boolean"
        },
        {
          "name": "right_blinker",
          "description": "Right turn signal active",
          "byteOffset": 0,
          "bitOffset": 2,
          "bitLength": 1,
          "type": "boolean"
        },
        {
          "name": "headlights",
          "description": "Headlights on",
          "byteOffset": 0,
          "bitOffset": 3,
          "bitLength": 1,
          "type": "boolean"
        },
        {
          "name": "hazards",
          "description": "Hazard lights active",
          "byteOffset": 0,
          "bitOffset": 4,
          "bitLength": 1,
          "type": "boolean"
        },
        {
          "name": "reverse",
          "description": "Reverse gear engaged",
          "byteOffset": 0,
          "bitOffset": 5,
          "bitLength": 1,
          "type": "boolean"
        }
      ]
    },
    {
      "id": "0x200",
      "name": "Drive Control",
      "description": "Throttle, speed, and drive status",
      "dlc": 4,
      "cycleTime": 50,
      "fields": [
        {
          "name": "throttle_position",
          "description": "Throttle pedal position",
          "byteOffset": 0,
          "bitOffset": 0,
          "bitLength": 8,
          "type": "uint",
          "scale": 0.39215686,
          "unit": "%",
          "min": 0,
          "max": 100
        },
        {
          "name": "vehicle_speed",
          "description": "Current vehicle speed",
          "byteOffset": 1,
          "bitOffset": 0,
          "bitLength": 8,
          "type": "uint",
          "scale": 0.5,
          "unit": "km/h",
          "min": 0,
          "max": 50
        },
        {
          "name": "motor_temperature",
          "description": "Motor controller temperature",
          "byteOffset": 2,
          "bitOffset": 0,
          "bitLength": 8,
          "type": "uint",
          "offset": -40,
          "unit": "°C",
          "min": -40,
          "max": 215
        },
        {
          "name": "drive_mode",
          "description": "Current drive mode",
          "byteOffset": 3,
          "bitOffset": 0,
          "bitLength": 2,
          "type": "enum",
          "enumValues": [
            { "value": 0, "label": "ECO", "description": "Economy mode" },
            { "value": 1, "label": "NORM", "description": "Normal mode" },
            { "value": 2, "label": "SPORT", "description": "Sport mode" },
            { "value": 3, "label": "FAULT", "description": "Fault state" }
          ]
        }
      ]
    },
    {
      "id": "0x300",
      "name": "Battery Status",
      "description": "Battery voltage, current, and state of charge",
      "dlc": 6,
      "cycleTime": 500,
      "fields": [
        {
          "name": "battery_voltage",
          "description": "Battery pack voltage",
          "byteOffset": 0,
          "bitOffset": 0,
          "bitLength": 16,
          "type": "uint",
          "byteOrder": "little",
          "scale": 0.01,
          "unit": "V",
          "min": 0,
          "max": 60
        },
        {
          "name": "battery_current",
          "description": "Battery pack current (negative = discharge)",
          "byteOffset": 2,
          "bitOffset": 0,
          "bitLength": 16,
          "type": "int",
          "byteOrder": "little",
          "scale": 0.1,
          "unit": "A",
          "min": -200,
          "max": 200
        },
        {
          "name": "state_of_charge",
          "description": "Battery state of charge",
          "byteOffset": 4,
          "bitOffset": 0,
          "bitLength": 8,
          "type": "uint",
          "unit": "%",
          "min": 0,
          "max": 100
        },
        {
          "name": "charging",
          "description": "Charger connected",
          "byteOffset": 5,
          "bitOffset": 0,
          "bitLength": 1,
          "type": "boolean"
        }
      ]
    }
  ],

  "widgets": [
    {
      "id": "brake_led",
      "config": {
        "type": "led",
        "label": "Brake",
        "colorOn": "#ff0000",
        "colorOff": "#440000",
        "size": "large",
        "showLabel": true
      },
      "messageId": "0x100",
      "fieldName": "brake_pressed"
    },
    {
      "id": "left_blinker_led",
      "config": {
        "type": "led",
        "label": "Left",
        "colorOn": "#ffaa00",
        "colorOff": "#443300",
        "size": "medium",
        "showLabel": true
      },
      "messageId": "0x100",
      "fieldName": "left_blinker"
    },
    {
      "id": "right_blinker_led",
      "config": {
        "type": "led",
        "label": "Right",
        "colorOn": "#ffaa00",
        "colorOff": "#443300",
        "size": "medium",
        "showLabel": true
      },
      "messageId": "0x100",
      "fieldName": "right_blinker"
    },
    {
      "id": "headlights_led",
      "config": {
        "type": "led",
        "label": "Lights",
        "colorOn": "#00ff00",
        "colorOff": "#004400",
        "size": "medium",
        "showLabel": true
      },
      "messageId": "0x100",
      "fieldName": "headlights"
    },
    {
      "id": "reverse_led",
      "config": {
        "type": "led",
        "label": "Reverse",
        "colorOn": "#ffffff",
        "colorOff": "#444444",
        "size": "medium",
        "showLabel": true
      },
      "messageId": "0x100",
      "fieldName": "reverse"
    },
    {
      "id": "speed_gauge",
      "config": {
        "type": "gauge",
        "label": "Speed",
        "min": 0,
        "max": 50,
        "unit": "km/h",
        "segments": 10,
        "width": 300,
        "height": 300
      },
      "messageId": "0x200",
      "fieldName": "vehicle_speed"
    },
    {
      "id": "throttle_bar",
      "config": {
        "type": "bar",
        "label": "Throttle",
        "min": 0,
        "max": 100,
        "unit": "%",
        "orientation": "vertical",
        "colorScale": "gradient",
        "width": 60,
        "height": 200
      },
      "messageId": "0x200",
      "fieldName": "throttle_position"
    },
    {
      "id": "motor_temp",
      "config": {
        "type": "temperature",
        "label": "Motor Temp",
        "precision": 0,
        "unit": "°C",
        "coldThreshold": 20,
        "normalRange": [40, 80],
        "hotThreshold": 95,
        "width": 150,
        "height": 100
      },
      "messageId": "0x200",
      "fieldName": "motor_temperature"
    },
    {
      "id": "drive_mode_text",
      "config": {
        "type": "text",
        "label": "Mode",
        "fontSize": 24,
        "showLabel": true,
        "width": 120,
        "height": 60
      },
      "messageId": "0x200",
      "fieldName": "drive_mode"
    },
    {
      "id": "battery_voltage_display",
      "config": {
        "type": "voltage",
        "label": "Battery",
        "precision": 1,
        "lowThreshold": 42.0,
        "highThreshold": 58.8,
        "width": 150,
        "height": 80
      },
      "messageId": "0x300",
      "fieldName": "battery_voltage"
    },
    {
      "id": "battery_soc_bar",
      "config": {
        "type": "bar",
        "label": "SOC",
        "min": 0,
        "max": 100,
        "unit": "%",
        "orientation": "horizontal",
        "colorScale": "gradient",
        "width": 200,
        "height": 40
      },
      "messageId": "0x300",
      "fieldName": "state_of_charge"
    },
    {
      "id": "battery_current_number",
      "config": {
        "type": "number",
        "label": "Current",
        "precision": 1,
        "unit": "A",
        "fontSize": 18,
        "width": 120,
        "height": 60
      },
      "messageId": "0x300",
      "fieldName": "battery_current"
    },
    {
      "id": "charging_led",
      "config": {
        "type": "led",
        "label": "Charging",
        "colorOn": "#00ff00",
        "colorOff": "#004400",
        "size": "small",
        "showLabel": true
      },
      "messageId": "0x300",
      "fieldName": "charging"
    }
  ],

  "layouts": [
    {
      "id": "main_dashboard",
      "name": "Main Dashboard",
      "description": "Primary driving display with speed, indicators, and battery status",
      "gridColumns": 12,
      "gridRows": 10,
      "backgroundColor": "#1a1a1a",
      "widgets": [
        {
          "widgetId": "speed_gauge",
          "position": { "x": 0, "y": 0, "width": 6, "height": 6 }
        },
        {
          "widgetId": "brake_led",
          "position": { "x": 7, "y": 0, "width": 2, "height": 1 }
        },
        {
          "widgetId": "left_blinker_led",
          "position": { "x": 6, "y": 1, "width": 2, "height": 1 }
        },
        {
          "widgetId": "right_blinker_led",
          "position": { "x": 9, "y": 1, "width": 2, "height": 1 }
        },
        {
          "widgetId": "headlights_led",
          "position": { "x": 7, "y": 2, "width": 2, "height": 1 }
        },
        {
          "widgetId": "reverse_led",
          "position": { "x": 7, "y": 3, "width": 2, "height": 1 }
        },
        {
          "widgetId": "throttle_bar",
          "position": { "x": 10, "y": 0, "width": 2, "height": 6 }
        },
        {
          "widgetId": "battery_voltage_display",
          "position": { "x": 0, "y": 7, "width": 3, "height": 2 }
        },
        {
          "widgetId": "battery_soc_bar",
          "position": { "x": 3, "y": 7, "width": 4, "height": 1 }
        },
        {
          "widgetId": "battery_current_number",
          "position": { "x": 3, "y": 8, "width": 2, "height": 1 }
        },
        {
          "widgetId": "motor_temp",
          "position": { "x": 7, "y": 7, "width": 3, "height": 2 }
        },
        {
          "widgetId": "drive_mode_text",
          "position": { "x": 10, "y": 7, "width": 2, "height": 1 }
        },
        {
          "widgetId": "charging_led",
          "position": { "x": 10, "y": 8, "width": 2, "height": 1 }
        }
      ]
    },
    {
      "id": "minimal_overlay",
      "name": "Minimal Overlay",
      "description": "Compact overlay with essential indicators only",
      "gridColumns": 8,
      "gridRows": 2,
      "backgroundColor": "transparent",
      "widgets": [
        {
          "widgetId": "brake_led",
          "position": { "x": 0, "y": 0, "width": 1, "height": 1 }
        },
        {
          "widgetId": "left_blinker_led",
          "position": { "x": 1, "y": 0, "width": 1, "height": 1 }
        },
        {
          "widgetId": "right_blinker_led",
          "position": { "x": 2, "y": 0, "width": 1, "height": 1 }
        },
        {
          "widgetId": "headlights_led",
          "position": { "x": 3, "y": 0, "width": 1, "height": 1 }
        },
        {
          "widgetId": "reverse_led",
          "position": { "x": 4, "y": 0, "width": 1, "height": 1 }
        },
        {
          "widgetId": "battery_soc_bar",
          "position": { "x": 0, "y": 1, "width": 5, "height": 1 }
        }
      ]
    },
    {
      "id": "battery_focus",
      "name": "Battery Focus",
      "description": "Detailed battery monitoring view",
      "gridColumns": 6,
      "gridRows": 4,
      "backgroundColor": "#0a0a0a",
      "widgets": [
        {
          "widgetId": "battery_voltage_display",
          "position": { "x": 0, "y": 0, "width": 3, "height": 2 }
        },
        {
          "widgetId": "battery_current_number",
          "position": { "x": 3, "y": 0, "width": 3, "height": 2 }
        },
        {
          "widgetId": "battery_soc_bar",
          "position": { "x": 0, "y": 2, "width": 5, "height": 1 }
        },
        {
          "widgetId": "charging_led",
          "position": { "x": 5, "y": 2, "width": 1, "height": 1 }
        }
      ]
    }
  ]
}
