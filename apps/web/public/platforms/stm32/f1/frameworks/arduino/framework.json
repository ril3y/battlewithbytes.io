{
  "id": "arduino",
  "name": "Arduino Framework",
  "version": "2.7.1",
  "description": "Arduino core for STM32F1 (STM32duino) - provides Arduino API compatibility",
  "website": "https://github.com/stm32duino/Arduino_Core_STM32",
  "documentation": "https://github.com/stm32duino/wiki/wiki",
  "license": "LGPL-2.1 / BSD-3-Clause",

  "coreFiles": {
    "url": "frameworks/arduino/core.tar.gz",
    "size": 307200,
    "checksum": "sha256:pending",
    "includes": [
      "/cores/arduino",
      "/variants/BLUEPILL_F103C8",
      "/system"
    ],
    "description": "Minimal STM32duino core with essential peripherals"
  },

  "compilerFlags": [
    "-std=gnu++14",
    "-fno-rtti",
    "-fno-exceptions",
    "-fno-threadsafe-statics",
    "-ffunction-sections",
    "-fdata-sections",
    "-fno-use-cxa-atexit",
    "-Os"
  ],

  "defines": [
    "ARDUINO=10819",
    "ARDUINO_BLUEPILL_F103C8",
    "ARDUINO_ARCH_STM32",
    "STM32F1xx",
    "STM32F103xB",
    "ARDUINO_BLUEPILL_F103C8",
    "HAL_UART_MODULE_ENABLED",
    "HAL_GPIO_MODULE_ENABLED",
    "HAL_RCC_MODULE_ENABLED",
    "HAL_CORTEX_MODULE_ENABLED",
    "HAL_TIM_MODULE_ENABLED",
    "HAL_ADC_MODULE_ENABLED",
    "HAL_DMA_MODULE_ENABLED",
    "HAL_FLASH_MODULE_ENABLED"
  ],

  "includePaths": [
    "cores/arduino",
    "cores/arduino/avr",
    "cores/arduino/stm32",
    "cores/arduino/stm32/LL",
    "cores/arduino/stm32/usb",
    "variants/BLUEPILL_F103C8",
    "system/STM32F1xx",
    "system/Drivers/STM32F1xx_HAL_Driver/Inc",
    "system/Drivers/STM32F1xx_HAL_Driver/Src",
    "system/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
    "system/Drivers/CMSIS/Device/ST/STM32F1xx/Source/Templates",
    "system/Drivers/CMSIS/Include"
  ],

  "linkerFlags": [
    "-Wl,--gc-sections",
    "-Wl,--print-memory-usage",
    "-specs=nano.specs",
    "-specs=nosys.specs"
  ],

  "buildOptions": {
    "requiresPreprocessing": true,
    "preprocessorRules": {
      "description": "Arduino .ino files need preprocessing before compilation",
      "steps": [
        "Scan for function declarations",
        "Generate function prototypes",
        "Prepend '#include <Arduino.h>'",
        "Concatenate multiple .ino files if present"
      ]
    },
    "fileExtensions": {
      "sketch": ".ino",
      "header": ".h",
      "source": [".cpp", ".c"]
    },
    "entryPoint": "setup() and loop() functions",
    "autoGeneratePrototypes": true
  },

  "features": {
    "serial": {
      "enabled": true,
      "description": "Hardware serial ports (UART)",
      "api": ["Serial.begin()", "Serial.print()", "Serial.read()"]
    },
    "digitalIO": {
      "enabled": true,
      "description": "Digital pin operations",
      "api": ["pinMode()", "digitalWrite()", "digitalRead()"]
    },
    "analogIO": {
      "enabled": true,
      "description": "Analog input/output",
      "api": ["analogRead()", "analogWrite()"]
    },
    "timing": {
      "enabled": true,
      "description": "Timing and delay functions",
      "api": ["delay()", "delayMicroseconds()", "millis()", "micros()"]
    },
    "interrupts": {
      "enabled": true,
      "description": "External interrupts",
      "api": ["attachInterrupt()", "detachInterrupt()"]
    },
    "pwm": {
      "enabled": true,
      "description": "PWM output via analogWrite()",
      "api": ["analogWrite()"]
    },
    "tone": {
      "enabled": true,
      "description": "Tone generation",
      "api": ["tone()", "noTone()"]
    },
    "wire": {
      "enabled": false,
      "description": "I2C communication (requires hal_i2c module)",
      "api": ["Wire.begin()", "Wire.write()", "Wire.read()"]
    },
    "spi": {
      "enabled": false,
      "description": "SPI communication (requires hal_spi module)",
      "api": ["SPI.begin()", "SPI.transfer()"]
    }
  },

  "peripheralModules": {
    "description": "Optional HAL modules that can be added to extend functionality",
    "available": [
      {
        "id": "hal_i2c",
        "name": "I2C/Wire",
        "files": ["stm32f1xx_hal_i2c.h", "stm32f1xx_hal_i2c.c"],
        "defines": ["HAL_I2C_MODULE_ENABLED"],
        "size": 45000
      },
      {
        "id": "hal_spi",
        "name": "SPI",
        "files": ["stm32f1xx_hal_spi.h", "stm32f1xx_hal_spi.c"],
        "defines": ["HAL_SPI_MODULE_ENABLED"],
        "size": 38000
      },
      {
        "id": "hal_usb",
        "name": "USB Device",
        "files": ["stm32f1xx_hal_pcd.h", "stm32f1xx_hal_pcd.c", "stm32f1xx_ll_usb.h", "stm32f1xx_ll_usb.c"],
        "defines": ["HAL_PCD_MODULE_ENABLED", "USE_USB_FS"],
        "size": 72000
      },
      {
        "id": "hal_rtc",
        "name": "Real-Time Clock",
        "files": ["stm32f1xx_hal_rtc.h", "stm32f1xx_hal_rtc.c", "stm32f1xx_hal_rtc_ex.h", "stm32f1xx_hal_rtc_ex.c"],
        "defines": ["HAL_RTC_MODULE_ENABLED"],
        "size": 42000
      },
      {
        "id": "hal_can",
        "name": "CAN Bus",
        "files": ["stm32f1xx_hal_can.h", "stm32f1xx_hal_can.c"],
        "defines": ["HAL_CAN_MODULE_ENABLED"],
        "size": 35000
      },
      {
        "id": "hal_dac",
        "name": "Digital-to-Analog Converter",
        "files": ["stm32f1xx_hal_dac.h", "stm32f1xx_hal_dac.c", "stm32f1xx_hal_dac_ex.h", "stm32f1xx_hal_dac_ex.c"],
        "defines": ["HAL_DAC_MODULE_ENABLED"],
        "size": 28000
      }
    ]
  },

  "examples": [
    {
      "id": "blink",
      "name": "Blink (Arduino)",
      "description": "Classic Arduino LED blink using digitalWrite()",
      "difficulty": "beginner",
      "file": "examples/arduino_blink.ino"
    },
    {
      "id": "serial",
      "name": "Serial Hello World",
      "description": "Print to serial monitor using Serial.println()",
      "difficulty": "beginner",
      "file": "examples/arduino_serial.ino"
    },
    {
      "id": "analog_read",
      "name": "Analog Input",
      "description": "Read analog sensor with analogRead()",
      "difficulty": "beginner",
      "file": "examples/arduino_analog.ino"
    },
    {
      "id": "pwm",
      "name": "PWM LED Fade",
      "description": "Fade LED using PWM with analogWrite()",
      "difficulty": "intermediate",
      "file": "examples/arduino_pwm.ino"
    }
  ],

  "compatibility": {
    "arduinoVersion": "1.8.19",
    "arduinoAPI": "1.0+",
    "coreVersion": "2.7.1",
    "stm32CubeVersion": "1.8.5",
    "cmsisVersion": "5.9.0",
    "notes": [
      "Most standard Arduino libraries are compatible",
      "Some AVR-specific libraries may need porting",
      "Timing values may differ from AVR boards",
      "analogWrite() PWM frequency is configurable"
    ]
  },

  "pins": {
    "description": "Blue Pill (STM32F103C8) pin mappings",
    "digital": {
      "count": 37,
      "pins": ["PA0-PA15", "PB0-PB15", "PC13-PC15"]
    },
    "analog": {
      "count": 10,
      "pins": ["PA0-PA7", "PB0-PB1"],
      "resolution": 12,
      "reference": "3.3V"
    },
    "pwm": {
      "count": 12,
      "pins": ["PA0-PA3", "PA6-PA7", "PA8-PA10", "PB0-PB1"],
      "resolution": 16,
      "defaultFrequency": 1000
    },
    "special": {
      "LED_BUILTIN": "PC13",
      "TX": "PA9",
      "RX": "PA10",
      "SDA": "PB7",
      "SCL": "PB6",
      "MOSI": "PA7",
      "MISO": "PA6",
      "SCK": "PA5",
      "SS": "PA4"
    }
  },

  "memoryMap": {
    "flash": {
      "size": 65536,
      "start": "0x08000000",
      "available": "~60KB after bootloader"
    },
    "ram": {
      "size": 20480,
      "start": "0x20000000",
      "available": "~18KB after stack/heap"
    }
  },

  "buildProcess": {
    "description": "Arduino sketch compilation workflow",
    "steps": [
      {
        "step": 1,
        "name": "Preprocessing",
        "description": "Convert .ino to .cpp with prototypes and Arduino.h"
      },
      {
        "step": 2,
        "name": "Compile Core",
        "description": "Compile cores/arduino/*.cpp files"
      },
      {
        "step": 3,
        "name": "Compile Variant",
        "description": "Compile variant-specific files"
      },
      {
        "step": 4,
        "name": "Compile HAL",
        "description": "Compile enabled HAL modules"
      },
      {
        "step": 5,
        "name": "Compile Sketch",
        "description": "Compile preprocessed sketch file"
      },
      {
        "step": 6,
        "name": "Link",
        "description": "Link all object files with variant linker script"
      }
    ]
  },

  "knownIssues": [
    "USB support requires additional configuration and drivers",
    "Some timing-sensitive operations may behave differently than AVR",
    "Serial baud rates above 115200 may be unstable without crystal",
    "analogWrite() PWM pins are limited by timer availability"
  ],

  "migrationGuide": {
    "fromAVR": [
      "Change analog reference from 5V to 3.3V",
      "Adjust pin numbers - STM32 uses port.pin notation",
      "Replace AVR-specific registers with HAL functions",
      "Update interrupt syntax if using direct ISRs"
    ],
    "fromBareMetal": [
      "Replace HAL_GPIO_WritePin() with digitalWrite()",
      "Replace HAL_Delay() with delay()",
      "Use Serial.print() instead of UART printf()",
      "Arduino handles clock configuration automatically"
    ]
  },

  "metadata": {
    "created": "2025-12-13",
    "lastUpdated": "2025-12-13",
    "maintainer": "BattleForge IDE",
    "upstream": "https://github.com/stm32duino/Arduino_Core_STM32",
    "upstreamVersion": "2.7.1",
    "packageFormat": "tar.gz",
    "compressionRatio": 3.5
  }
}
