{
  "id": "nrf52",
  "name": "nRF52 Series (Cortex-M4F)",
  "description": "Ultra low power wireless SoC with BLE 5.0 support. Popular for IoT and wearable applications.",
  "architecture": "cortex-m4f",
  "releaseYear": 2016,
  "status": "active",
  "documentation": {
    "datasheet": "https://infocenter.nordicsemi.com/pdf/nRF52832_PS_v1.4.pdf",
    "reference": "https://infocenter.nordicsemi.com/topic/ps_nrf52840/keyfeatures_html5.html",
    "programming": "https://infocenter.nordicsemi.com/topic/sdk_nrf5_v17.1.0/index.html"
  },
  "features": {
    "maxFrequency": 64,
    "fpu": true,
    "dsp": false,
    "mpu": true,
    "peripherals": ["BLE", "NFC", "USB", "I2C", "SPI", "UART", "ADC", "PWM", "Timer", "RTC", "GPIO", "Crypto"]
  },
  "compilerFlags": [
    "--target=thumbv7em-none-eabihf",
    "-mcpu=cortex-m4",
    "-mfpu=fpv4-sp-d16",
    "-mfloat-abi=hard",
    "-mthumb",
    "-nostdlib",
    "-ffreestanding",
    "-fno-exceptions",
    "-fno-rtti"
  ],
  "linkerFlags": [
    "-nostdlib",
    "--gc-sections"
  ],
  "devices": [
    {
      "id": "nrf52832",
      "name": "nRF52832 (Cortex-M4F)",
      "description": "512KB Flash, 64KB RAM, BLE 5.0, NFC",
      "flash": 524288,
      "ram": 65536,
      "package": "QFN48",
      "pins": 48,
      "linkerScript": "nrf52832.ld",
      "defines": ["NRF52832_XXAA", "NRF52", "NRF52_SERIES"],
      "boards": [
        {
          "name": "Adafruit Feather nRF52832",
          "led": "P0.17",
          "crystal": 32768,
          "buy": "https://www.adafruit.com/product/3406"
        },
        {
          "name": "Nordic nRF52 DK",
          "led": "P0.17",
          "crystal": 32768,
          "buy": "https://www.nordicsemi.com/Products/Development-hardware/nrf52-dk"
        }
      ]
    },
    {
      "id": "nrf52840",
      "name": "nRF52840 (Cortex-M4F)",
      "description": "1MB Flash, 256KB RAM, BLE 5.0, USB, NFC",
      "flash": 1048576,
      "ram": 262144,
      "package": "AQFN73",
      "pins": 73,
      "linkerScript": "nrf52840.ld",
      "defines": ["NRF52840_XXAA", "NRF52", "NRF52_SERIES"],
      "boards": [
        {
          "name": "Adafruit Feather nRF52840 Express",
          "led": "P0.13",
          "crystal": 32768,
          "buy": "https://www.adafruit.com/product/4062"
        },
        {
          "name": "Nordic nRF52840 DK",
          "led": "P0.13",
          "crystal": 32768,
          "buy": "https://www.nordicsemi.com/Products/Development-hardware/nrf52840-dk"
        },
        {
          "name": "Particle Xenon",
          "led": "P0.13",
          "crystal": 32768,
          "buy": "https://store.particle.io/"
        }
      ]
    }
  ],
  "headers": {
    "url": "nrf/nrf52/headers.tar.gz",
    "size": 145000,
    "checksum": "sha256:pending",
    "includes": ["/cmsis", "/device", "/libc"],
    "source": {
      "cmsis": "https://github.com/ARM-software/CMSIS_5",
      "device": "https://github.com/NordicSemiconductor/nrfx"
    }
  },
  "libs": {
    "architecture": "cortex-m4f",
    "required": ["libc_nano.a", "libnosys.a"],
    "optional": ["libm.a", "libgcc.a"]
  },
  "frameworks": [
    {
      "frameworkId": "native",
      "enabled": true,
      "version": "1.0.0",
      "framework": {
        "id": "native",
        "name": "Native (Bare Metal)",
        "description": "Direct register access without abstraction layers. Maximum control and efficiency for nRF52.",
        "version": "1.0.0",
        "compilerFlags": ["-nostdlib", "-ffreestanding"],
        "linkerFlags": ["-nostdlib", "--gc-sections"],
        "defines": [],
        "includePaths": []
      }
    },
    {
      "frameworkId": "arduino",
      "enabled": true,
      "version": "1.3.0",
      "framework": {
        "id": "arduino",
        "name": "Arduino (Adafruit nRF52)",
        "description": "Arduino API with BLE support via Adafruit nRF52 Arduino core. Includes Bluefruit libraries.",
        "version": "1.3.0",
        "compilerFlags": [
          "-std=gnu++14",
          "-fno-rtti",
          "-fno-exceptions",
          "-fno-threadsafe-statics",
          "-Os"
        ],
        "linkerFlags": ["--gc-sections"],
        "defines": [
          "ARDUINO=10819",
          "ARDUINO_ARCH_NRF52",
          "ARDUINO_NRF52_ADAFRUIT",
          "NRF52_S132"
        ],
        "includePaths": [
          "/cores/nRF5",
          "/variants/feather_nrf52840_express",
          "/libraries/Bluefruit52Lib/src"
        ],
        "coreUrl": "nrf/nrf52/frameworks/arduino/core.tar.gz",
        "coreChecksum": "sha256:pending",
        "requiresPreprocessing": true,
        "fileExtension": ".ino"
      }
    },
    {
      "frameworkId": "zephyr",
      "enabled": true,
      "version": "3.5.0",
      "framework": {
        "id": "zephyr",
        "name": "Zephyr RTOS",
        "description": "Scalable real-time OS for IoT devices with extensive BLE and mesh networking support.",
        "version": "3.5.0",
        "compilerFlags": [
          "-std=c11",
          "-fno-common",
          "-ffunction-sections",
          "-fdata-sections"
        ],
        "linkerFlags": ["--gc-sections"],
        "defines": [
          "__ZEPHYR__",
          "CONFIG_NRF52",
          "CONFIG_BT=1"
        ],
        "includePaths": [
          "/zephyr/include",
          "/zephyr/arch/arm",
          "/zephyr/subsys/bluetooth"
        ],
        "coreUrl": "nrf/nrf52/frameworks/zephyr/core.tar.gz",
        "coreChecksum": "sha256:pending",
        "requiresPreprocessing": false
      }
    }
  ],
  "examples": [
    {
      "id": "blink",
      "name": "LED Blink",
      "description": "Toggle LED on P0.13",
      "file": "examples/blink.c",
      "difficulty": "beginner"
    },
    {
      "id": "ble_uart",
      "name": "BLE UART Service",
      "description": "Nordic UART Service (NUS) over BLE",
      "file": "examples/ble_uart.c",
      "difficulty": "intermediate"
    },
    {
      "id": "low_power",
      "name": "Low Power Mode",
      "description": "Demonstrate ultra-low power sleep modes",
      "file": "examples/low_power.c",
      "difficulty": "intermediate"
    },
    {
      "id": "ble_beacon",
      "name": "BLE Beacon",
      "description": "iBeacon/Eddystone beacon broadcasting",
      "file": "examples/ble_beacon.c",
      "difficulty": "beginner"
    }
  ]
}
