{
  "id": "nrf53",
  "name": "nRF53 Series (Cortex-M33)",
  "description": "Dual-core wireless SoC with Arm TrustZone security. Application core (M33) + Network core (M33) for advanced BLE and mesh applications.",
  "architecture": "cortex-m33",
  "releaseYear": 2020,
  "status": "active",
  "documentation": {
    "datasheet": "https://infocenter.nordicsemi.com/pdf/nRF5340_PS_v1.3.pdf",
    "reference": "https://infocenter.nordicsemi.com/topic/ps_nrf5340/keyfeatures_html5.html",
    "programming": "https://infocenter.nordicsemi.com/topic/sdk_nrf5_v17.1.0/index.html"
  },
  "features": {
    "maxFrequency": 128,
    "fpu": true,
    "dsp": true,
    "mpu": true,
    "trustzone": true,
    "dualCore": true,
    "peripherals": ["BLE", "Thread", "Zigbee", "NFC", "USB", "I2C", "SPI", "UART", "QSPI", "ADC", "PWM", "Timer", "RTC", "GPIO", "Crypto"]
  },
  "compilerFlags": [
    "--target=thumbv8m.main-none-eabihf",
    "-mcpu=cortex-m33",
    "-mfpu=fpv5-sp-d16",
    "-mfloat-abi=hard",
    "-mthumb",
    "-nostdlib",
    "-ffreestanding",
    "-fno-exceptions",
    "-fno-rtti"
  ],
  "linkerFlags": [
    "-nostdlib",
    "--gc-sections"
  ],
  "devices": [
    {
      "id": "nrf5340",
      "name": "nRF5340 (Dual Cortex-M33)",
      "description": "1MB Flash, 512KB RAM (Application Core), 256KB Flash, 64KB RAM (Network Core), BLE 5.2, Thread, Zigbee",
      "flash": 1048576,
      "ram": 524288,
      "package": "AQFN94",
      "pins": 94,
      "linkerScript": "nrf5340_xxaa_application.ld",
      "defines": ["NRF5340_XXAA", "NRF5340", "NRF53_SERIES", "NRF_APPLICATION"],
      "boards": [
        {
          "name": "Nordic nRF5340 DK",
          "led": "P0.28",
          "crystal": 32768,
          "buy": "https://www.nordicsemi.com/Products/Development-hardware/nrf5340-dk"
        },
        {
          "name": "Thingy:53",
          "led": "P0.28",
          "crystal": 32768,
          "buy": "https://www.nordicsemi.com/Products/Development-hardware/Nordic-Thingy-53"
        }
      ]
    },
    {
      "id": "nrf5340_network",
      "name": "nRF5340 Network Core (Cortex-M33)",
      "description": "Network processor - 256KB Flash, 64KB RAM, dedicated to wireless protocols",
      "flash": 262144,
      "ram": 65536,
      "package": "AQFN94",
      "pins": 94,
      "linkerScript": "nrf5340_xxaa_network.ld",
      "defines": ["NRF5340_XXAA", "NRF5340", "NRF53_SERIES", "NRF_NETWORK"],
      "boards": [
        {
          "name": "Nordic nRF5340 DK (Network Core)",
          "led": "P0.28",
          "crystal": 32768,
          "buy": "https://www.nordicsemi.com/Products/Development-hardware/nrf5340-dk"
        }
      ]
    }
  ],
  "headers": {
    "url": "nrf/nrf53/headers.tar.gz",
    "size": 165000,
    "checksum": "sha256:pending",
    "includes": ["/cmsis", "/device", "/libc", "/trustzone"],
    "source": {
      "cmsis": "https://github.com/ARM-software/CMSIS_5",
      "device": "https://github.com/NordicSemiconductor/nrfx"
    }
  },
  "libs": {
    "architecture": "cortex-m33",
    "required": ["libc_nano.a", "libnosys.a"],
    "optional": ["libm.a", "libgcc.a"]
  },
  "frameworks": [
    {
      "frameworkId": "native",
      "enabled": true,
      "version": "1.0.0",
      "framework": {
        "id": "native",
        "name": "Native (Bare Metal)",
        "description": "Direct register access for both application and network cores. Full control over dual-core architecture.",
        "version": "1.0.0",
        "compilerFlags": ["-nostdlib", "-ffreestanding"],
        "linkerFlags": ["-nostdlib", "--gc-sections"],
        "defines": [],
        "includePaths": []
      }
    },
    {
      "frameworkId": "arduino",
      "enabled": true,
      "version": "1.0.0",
      "framework": {
        "id": "arduino",
        "name": "Arduino (Adafruit nRF52)",
        "description": "Arduino API for nRF53 application core. Network core runs BLE stack separately.",
        "version": "1.0.0",
        "compilerFlags": [
          "-std=gnu++14",
          "-fno-rtti",
          "-fno-exceptions",
          "-fno-threadsafe-statics",
          "-Os"
        ],
        "linkerFlags": ["--gc-sections"],
        "defines": [
          "ARDUINO=10819",
          "ARDUINO_ARCH_NRF52",
          "ARDUINO_NRF53_ADAFRUIT",
          "NRF5340_XXAA"
        ],
        "includePaths": [
          "/cores/nRF5",
          "/variants/nrf5340_dk",
          "/libraries/Bluefruit52Lib/src"
        ],
        "coreUrl": "nrf/nrf53/frameworks/arduino/core.tar.gz",
        "coreChecksum": "sha256:pending",
        "requiresPreprocessing": true,
        "fileExtension": ".ino"
      }
    },
    {
      "frameworkId": "zephyr",
      "enabled": true,
      "version": "3.5.0",
      "framework": {
        "id": "zephyr",
        "name": "Zephyr RTOS",
        "description": "Advanced RTOS with full dual-core support, BLE, Thread, Zigbee, and TrustZone security features.",
        "version": "3.5.0",
        "compilerFlags": [
          "-std=c11",
          "-fno-common",
          "-ffunction-sections",
          "-fdata-sections"
        ],
        "linkerFlags": ["--gc-sections"],
        "defines": [
          "__ZEPHYR__",
          "CONFIG_NRF5340",
          "CONFIG_BT=1",
          "CONFIG_TRUSTED_EXECUTION_NONSECURE=1"
        ],
        "includePaths": [
          "/zephyr/include",
          "/zephyr/arch/arm",
          "/zephyr/subsys/bluetooth",
          "/zephyr/subsys/net/l2/openthread"
        ],
        "coreUrl": "nrf/nrf53/frameworks/zephyr/core.tar.gz",
        "coreChecksum": "sha256:pending",
        "requiresPreprocessing": false
      }
    }
  ],
  "examples": [
    {
      "id": "blink",
      "name": "LED Blink",
      "description": "Toggle LED on P0.28 (Application Core)",
      "file": "examples/blink.c",
      "difficulty": "beginner"
    },
    {
      "id": "dual_core",
      "name": "Dual-Core Communication",
      "description": "IPC between application and network cores",
      "file": "examples/dual_core.c",
      "difficulty": "advanced"
    },
    {
      "id": "ble_thread",
      "name": "BLE + Thread Gateway",
      "description": "Concurrent BLE and Thread networking",
      "file": "examples/ble_thread.c",
      "difficulty": "advanced"
    },
    {
      "id": "trustzone",
      "name": "TrustZone Security",
      "description": "Secure/non-secure partition example",
      "file": "examples/trustzone.c",
      "difficulty": "advanced"
    }
  ]
}
