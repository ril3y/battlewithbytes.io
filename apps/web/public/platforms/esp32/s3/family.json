{
  "id": "s3",
  "name": "ESP32-S3 Series (Xtensa LX7)",
  "description": "Dual-core Xtensa LX7 MCU with WiFi, BLE, and AI acceleration. Ideal for IoT and edge AI applications.",
  "architecture": "xtensa-lx7",
  "releaseYear": 2020,
  "status": "active",
  "documentation": {
    "datasheet": "https://www.espressif.com/sites/default/files/documentation/esp32-s3_datasheet_en.pdf",
    "reference": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32s3/",
    "programming": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32s3/api-guides/index.html"
  },
  "features": {
    "maxFrequency": 240,
    "fpu": true,
    "dsp": false,
    "mpu": true,
    "peripherals": ["WiFi", "BLE", "USB-OTG", "I2C", "SPI", "UART", "ADC", "DAC", "Timer", "DMA", "GPIO", "Camera", "LCD"]
  },
  "compilerFlags": [
    "--target=xtensa-esp32s3-elf",
    "-mlongcalls",
    "-nostdlib",
    "-ffreestanding",
    "-fno-exceptions",
    "-fno-rtti"
  ],
  "linkerFlags": [
    "-nostdlib",
    "--gc-sections"
  ],
  "devices": [
    {
      "id": "esp32s3_wroom1",
      "name": "ESP32-S3-WROOM-1",
      "description": "8MB Flash, 512KB SRAM, WiFi+BLE - Standard module",
      "flash": 8388608,
      "ram": 524288,
      "package": "SMD-40",
      "pins": 40,
      "linkerScript": "esp32s3.ld",
      "defines": ["CONFIG_IDF_TARGET_ESP32S3", "ESP32S3"],
      "boards": [
        {
          "name": "ESP32-S3-WROOM-1",
          "led": "GPIO38",
          "crystal": 40000000,
          "buy": "https://www.espressif.com/en/products/modules"
        }
      ]
    },
    {
      "id": "esp32s3_devkitc",
      "name": "ESP32-S3-DevKitC-1",
      "description": "8MB Flash, 512KB SRAM, WiFi+BLE - Development board",
      "flash": 8388608,
      "ram": 524288,
      "package": "Development Board",
      "pins": 44,
      "linkerScript": "esp32s3.ld",
      "defines": ["CONFIG_IDF_TARGET_ESP32S3", "ESP32S3", "ARDUINO_ESP32S3_DEV"],
      "boards": [
        {
          "name": "ESP32-S3-DevKitC-1",
          "led": "GPIO38",
          "crystal": 40000000,
          "buy": "https://www.espressif.com/en/products/devkits/esp32-s3-devkitc-1"
        }
      ]
    },
    {
      "id": "esp32s3_devkitc_16mb",
      "name": "ESP32-S3-DevKitC-1 (16MB Flash)",
      "description": "16MB Flash, 512KB SRAM, WiFi+BLE, 8MB PSRAM - Extended development board",
      "flash": 16777216,
      "ram": 524288,
      "package": "Development Board",
      "pins": 44,
      "linkerScript": "esp32s3.ld",
      "defines": ["CONFIG_IDF_TARGET_ESP32S3", "ESP32S3", "ARDUINO_ESP32S3_DEV", "BOARD_HAS_PSRAM"],
      "boards": [
        {
          "name": "ESP32-S3-DevKitC-1 N16R8",
          "led": "GPIO38",
          "crystal": 40000000,
          "buy": "https://www.espressif.com/en/products/devkits/esp32-s3-devkitc-1"
        }
      ]
    }
  ],
  "headers": {
    "url": "esp32/s3/headers.tar.gz",
    "size": 250000,
    "checksum": "sha256:pending",
    "includes": ["/esp-idf", "/xtensa", "/soc"],
    "source": {
      "esp-idf": "https://github.com/espressif/esp-idf",
      "xtensa": "https://github.com/espressif/xtensa-toolchain"
    }
  },
  "libs": {
    "architecture": "xtensa-lx7",
    "required": ["libc.a", "libgcc.a", "libhal.a"],
    "optional": ["libm.a", "libstdc++.a"]
  },
  "frameworks": [
    {
      "frameworkId": "native",
      "enabled": true,
      "version": "5.1.0",
      "framework": {
        "id": "native",
        "name": "Native (ESP-IDF)",
        "description": "ESP-IDF bare metal development with direct register access and FreeRTOS support.",
        "version": "5.1.0",
        "compilerFlags": ["-nostdlib", "-ffreestanding", "-mlongcalls"],
        "linkerFlags": ["-nostdlib", "--gc-sections"],
        "defines": ["ESP_PLATFORM", "IDF_VER=\"v5.1\""],
        "includePaths": ["/esp-idf/components", "/soc/esp32s3/include"]
      }
    },
    {
      "frameworkId": "arduino",
      "enabled": true,
      "version": "3.0.0",
      "framework": {
        "id": "arduino",
        "name": "Arduino-ESP32",
        "description": "Arduino framework for ESP32 with WiFi, BLE, and extensive library support.",
        "version": "3.0.0",
        "compilerFlags": ["-std=gnu++17", "-fno-rtti", "-fno-exceptions", "-mlongcalls", "-Os"],
        "linkerFlags": ["--gc-sections"],
        "defines": ["ARDUINO=10819", "ARDUINO_ARCH_ESP32", "ARDUINO_ESP32S3_DEV", "ESP32"],
        "includePaths": ["/cores/esp32", "/variants/esp32s3"],
        "coreUrl": "esp32/s3/frameworks/arduino/core.tar.gz",
        "coreChecksum": "sha256:pending",
        "requiresPreprocessing": true,
        "fileExtension": ".ino"
      }
    }
  ],
  "examples": [
    {
      "id": "blink",
      "name": "LED Blink",
      "description": "Toggle LED on GPIO38",
      "file": "examples/blink.c",
      "difficulty": "beginner"
    },
    {
      "id": "wifi_scan",
      "name": "WiFi Scan",
      "description": "Scan for available WiFi networks",
      "file": "examples/wifi_scan.c",
      "difficulty": "beginner"
    },
    {
      "id": "ble_beacon",
      "name": "BLE Beacon",
      "description": "Create a BLE beacon advertising device",
      "file": "examples/ble_beacon.c",
      "difficulty": "intermediate"
    },
    {
      "id": "websocket",
      "name": "WebSocket Server",
      "description": "Create a WebSocket server for real-time communication",
      "file": "examples/websocket.c",
      "difficulty": "advanced"
    }
  ]
}
