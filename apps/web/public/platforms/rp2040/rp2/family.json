{
  "id": "rp2",
  "name": "RP2040 (Dual Cortex-M0+)",
  "description": "Raspberry Pi's first microcontroller. Dual-core ARM Cortex-M0+ with unique PIO state machines for flexible I/O.",
  "architecture": "cortex-m0+",
  "releaseYear": 2021,
  "status": "active",
  "documentation": {
    "datasheet": "https://datasheets.raspberrypi.com/rp2040/rp2040-datasheet.pdf",
    "reference": "https://datasheets.raspberrypi.com/pico/raspberry-pi-pico-c-sdk.pdf",
    "programming": "https://datasheets.raspberrypi.com/pico/getting-started-with-pico.pdf"
  },
  "features": {
    "maxFrequency": 133,
    "cores": 2,
    "fpu": false,
    "dsp": false,
    "mpu": false,
    "pio": true,
    "pioStateMachines": 8,
    "peripherals": ["USB", "I2C", "SPI", "UART", "ADC", "PWM", "Timer", "DMA", "GPIO", "PIO", "RTC"]
  },
  "compilerFlags": [
    "--target=thumbv6m-none-eabi",
    "-mcpu=cortex-m0plus",
    "-mthumb",
    "-nostdlib",
    "-ffreestanding",
    "-fno-exceptions",
    "-fno-rtti"
  ],
  "linkerFlags": [
    "-nostdlib",
    "--gc-sections"
  ],
  "devices": [
    {
      "id": "pico",
      "name": "Raspberry Pi Pico",
      "description": "2MB Flash, 264KB RAM, Dual Cortex-M0+",
      "flash": 2097152,
      "ram": 270336,
      "package": "QFN-56",
      "pins": 26,
      "linkerScript": "pico.ld",
      "defines": ["PICO_BOARD=pico", "PICO_RP2040"],
      "boards": [
        {
          "name": "Raspberry Pi Pico",
          "led": "GP25",
          "crystal": 12000000,
          "buy": "https://www.raspberrypi.com/products/raspberry-pi-pico/"
        }
      ]
    },
    {
      "id": "pico_w",
      "name": "Raspberry Pi Pico W",
      "description": "2MB Flash, 264KB RAM, WiFi (CYW43439)",
      "flash": 2097152,
      "ram": 270336,
      "package": "QFN-56",
      "pins": 26,
      "linkerScript": "pico_w.ld",
      "defines": ["PICO_BOARD=pico_w", "PICO_RP2040", "CYW43_LWIP"],
      "boards": [
        {
          "name": "Raspberry Pi Pico W",
          "led": "WL_GPIO0",
          "crystal": 12000000,
          "buy": "https://www.raspberrypi.com/products/raspberry-pi-pico/"
        }
      ]
    }
  ],
  "headers": {
    "url": "rp2040/rp2/headers.tar.gz",
    "size": 256000,
    "checksum": "sha256:pending",
    "includes": ["/cmsis", "/pico_sdk", "/hardware"],
    "source": {
      "cmsis": "https://github.com/ARM-software/CMSIS_5",
      "pico_sdk": "https://github.com/raspberrypi/pico-sdk"
    }
  },
  "libs": {
    "architecture": "cortex-m0plus",
    "required": ["libc_nano.a", "libnosys.a"],
    "optional": ["libm.a", "libgcc.a"]
  },
  "frameworks": [
    {
      "frameworkId": "native",
      "enabled": true,
      "version": "1.5.1",
      "framework": {
        "id": "native",
        "name": "Native (Pico SDK)",
        "description": "Raspberry Pi Pico SDK - official C/C++ development framework with full hardware access",
        "version": "1.5.1",
        "compilerFlags": ["-nostdlib", "-ffreestanding"],
        "linkerFlags": ["-nostdlib", "--gc-sections"],
        "defines": ["PICO_SDK"],
        "includePaths": []
      }
    },
    {
      "frameworkId": "arduino",
      "enabled": true,
      "version": "3.6.0",
      "framework": {
        "id": "arduino",
        "name": "Arduino-Pico",
        "description": "Arduino framework for RP2040 with Pico SDK integration. Provides familiar Arduino API.",
        "version": "3.6.0",
        "compilerFlags": [
          "-std=gnu++17",
          "-fno-rtti",
          "-fno-exceptions",
          "-fno-threadsafe-statics",
          "-ffunction-sections",
          "-fdata-sections",
          "-fno-use-cxa-atexit",
          "-Os"
        ],
        "linkerFlags": [
          "--gc-sections",
          "--print-memory-usage"
        ],
        "defines": [
          "ARDUINO=10819",
          "ARDUINO_ARCH_RP2040",
          "ARDUINO_RASPBERRY_PI_PICO",
          "PICO_RP2040"
        ],
        "includePaths": [
          "/cores/rp2040",
          "/variants/rpipico"
        ],
        "coreUrl": "rp2040/rp2/frameworks/arduino/core.tar.gz",
        "coreChecksum": "sha256:pending",
        "requiresPreprocessing": true,
        "fileExtension": ".ino"
      }
    }
  ],
  "examples": [
    {
      "id": "blink",
      "name": "LED Blink",
      "description": "Toggle onboard LED on GP25",
      "file": "examples/blink.c",
      "difficulty": "beginner"
    },
    {
      "id": "uart",
      "name": "UART Hello",
      "description": "Send Hello World over UART",
      "file": "examples/uart.c",
      "difficulty": "beginner"
    },
    {
      "id": "pio_blink",
      "name": "PIO Blink",
      "description": "Use PIO state machine to blink LED",
      "file": "examples/pio_blink.c",
      "difficulty": "intermediate"
    },
    {
      "id": "multicore",
      "name": "Dual Core",
      "description": "Run code on both cores simultaneously",
      "file": "examples/multicore.c",
      "difficulty": "advanced"
    }
  ]
}
