# --- Dependencies ---
node_modules/
.pnp
.pnp.*

# --- Next.js / build output ---
.next/
out/
build/
dist/
/static-export/
*.tsbuildinfo
next-env.d.ts

# --- Test / lint output ---
coverage/
eslint-report.json
jest-results.json
build-output.txt

# --- Turborepo ---
.turbo

# --- Rust / Cargo ---
**/target/
**/*.rs.bk
**/Cargo.lock
*.pdb

# --- WASM build output (generated or fetched at build time) ---
**/pkg/
**/*.wasm
**/*.wasm.gz

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# --- Env files (opt in deliberately if ever needed) ---
.env*

# --- Editor / OS ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- Vercel ---
.vercel

# --- Package-manager lockfiles other than pnpm-lock.yaml ---
package-lock.json
yarn.lock

# --- Firmware files and debugging artifacts ---
*.so
*.bin
*.elf
*.hex
*.srec
*.pyc
*.py[cod]
# tracked test fixtures are exempt
!packages/battlemagic-analyzer/fixtures/*.elf

# --- Editor temp / abandoned rewrites ---
*.new

# --- Local scratch (never tracked) ---
/experiments/
/uCAN
nul
/repo.md
/notes.txt
/*_IMPLEMENTATION*.md
/*_ANALYSIS*.md
/*_SUMMARY*.md
/INVESTIGATION_REPORT.md
/QUICK_REFERENCE.md
/PHASE*.md

# --- Claude Code local settings (never commit) ---
.claude/settings.local.json

# --- Misc ---
*.pem

# Generated by apps/web prebuild
apps/web/public/rss.xml
apps/web/public/blog-data.json

# Battleforge tool output is deployed from apps/battleforge/out, never from web
apps/web/public/tools/
