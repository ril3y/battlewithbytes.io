# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust/Cargo
target/
**/*.rs.bk
*.pdb
Cargo.lock

# WASM build output (will be generated during build)
packages/battlemagic-core/pkg/
packages/*/pkg/
# Node modules
/node_modules/

# Production build output
/.next/
/out/
/build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Build artifacts
dist/
*.log

# Optional: if using coverage tool
coverage/

# Mac-specific files
.AppleDouble
.LSOverride

# Exclude static exports that are deployed
/static-export/

# Reference directories (root level only)
/uCAN
nul

# Temporary documentation and notes (root level only)
/repo.md
/notes.txt
/*_IMPLEMENTATION*.md
/*_ANALYSIS*.md
/*_SUMMARY*.md
/INVESTIGATION_REPORT.md
/QUICK_REFERENCE.md
/PHASE*.md

# Build tooling (not needed in production)
experiments/yowasp-clang/

# Claude Code local settings (never commit)
.claude/settings.local.json

# Turborepo
.turbo
dist/
build/

# Workspace
apps/*/node_modules
packages/*/node_modules
apps/*/.next
apps/*/out
packages/*/dist

# Rust
**/target/
**/*.rs.bk
**/Cargo.lock

# WASM
**/pkg/
**/*.wasm
# WASM binaries (generated during build)
apps/web/public/wasm/*.wasm

# Firmware files and debugging artifacts
*.so
*.bin
*.elf
*.hex
*.srec
firmware_*.bin
*.pyc
*.py[cod]
