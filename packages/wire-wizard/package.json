{
  "name": "@battlewithbytes/wire-wizard",
  "version": "0.1.0",
  "description": "Interactive wiring-diagram editor and viewer (Wire Wizard)",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles/editor.css": "./src/styles/editor.css"
  },
  "files": [
    "dist/**",
    "src/styles/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@battlewithbytes/eslint-config": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "wire-wizard",
    "wiring-diagram",
    "schematic",
    "react",
    "svg",
    "circuit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/battlewithbytes/battlewithbytes.io"
  }
}
