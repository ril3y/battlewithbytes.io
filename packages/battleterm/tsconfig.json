{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@battlewithbytes/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
