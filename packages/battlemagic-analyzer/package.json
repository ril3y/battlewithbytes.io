{
  "name": "battlemagic-analyzer",
  "version": "0.1.0",
  "description": "WebAssembly-powered binary analysis engine for ARM and MIPS architectures",
  "main": "pkg/battlemagic_analyzer.js",
  "types": "pkg/battlemagic_analyzer.d.ts",
  "exports": {
    ".": {
      "import": "./pkg/battlemagic_analyzer.js",
      "types": "./pkg/battlemagic_analyzer.d.ts"
    },
    "./pkg/*": "./pkg/*"
  },
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "echo 'WASM build handled by build:wasm task'",
    "build:wasm": "wasm-pack build --target bundler --out-dir pkg"
  },
  "keywords": [
    "wasm",
    "binary-analysis",
    "disassembly",
    "arm",
    "mips",
    "cross-reference",
    "reverse-engineering"
  ],
  "author": "ril3y",
  "license": "MIT",
  "devDependencies": {
    "serialport": "^13.0.0"
  }
}
