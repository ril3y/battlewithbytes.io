{
  "name": "@battlewithbytes/battlemagic-ui",
  "version": "0.1.0",
  "description": "React UI components for BattleMagic debugger",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@battlewithbytes/battlemagic-core": "workspace:*"
  },
  "devDependencies": {
    "@battlewithbytes/eslint-config": "workspace:*",
    "@battlewithbytes/tsconfig": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "debugger",
    "ui",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/battlewithbytes/battlewithbytes.io"
  }
}
