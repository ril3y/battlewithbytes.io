# Multi-Stage Dockerfile for Fast CI/CD Rebuilds
# Stage 1: LLVM source (cached, rarely changes)
# Stage 2: LLVM build (cached, only rebuilds if source or config changes)
# Stage 3: Custom WASM code (rebuilds quickly when you modify your code)

# ==============================================================================
# Stage 1: Base + LLVM Source (CACHED - 1-2 min to clone)
# ==============================================================================
FROM emscripten/emsdk:3.1.50 AS llvm-source

# Install build dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    git \
    curl \
    gzip \
    bc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone LLVM (this layer is cached until LLVM version changes)
ARG LLVM_VERSION=release/18.x
RUN git clone --depth=1 --branch=${LLVM_VERSION} https://github.com/llvm/llvm-project.git

# ==============================================================================
# Stage 2: LLVM Build (CACHED - 30-60 min first time, then cached)
# ==============================================================================
FROM llvm-source AS llvm-build

# Build configuration
ARG LLVM_TARGETS=ARM
ARG BUILD_TYPE=MinSizeRel

# Configure LLVM/Clang with our patches
RUN mkdir -p build-wasm && cd build-wasm && \
    emcmake cmake ../llvm-project/llvm \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DLLVM_TARGETS_TO_BUILD="${LLVM_TARGETS}" \
      -DLLVM_ENABLE_PROJECTS="clang;lld" \
      -DLLVM_ENABLE_DUMP=OFF \
      -DLLVM_ENABLE_ASSERTIONS=OFF \
      -DLLVM_ENABLE_EXPENSIVE_CHECKS=OFF \
      -DLLVM_ENABLE_BACKTRACES=OFF \
      -DLLVM_BUILD_TOOLS=OFF \
      -DLLVM_ENABLE_THREADS=OFF \
      -DLLVM_BUILD_LLVM_DYLIB=OFF \
      -DLLVM_INCLUDE_TESTS=OFF \
      -DLLVM_INCLUDE_EXAMPLES=OFF \
      -DLLVM_INCLUDE_BENCHMARKS=OFF \
      -DLLVM_OPTIMIZED_TABLEGEN=ON \
      -DCLANG_ENABLE_ARCMT=OFF \
      -DCLANG_ENABLE_STATIC_ANALYZER=OFF \
      -DHAVE_WAIT4=0 \
      -DHAVE_POSIX_SPAWN=0 \
      -DCMAKE_EXE_LINKER_FLAGS="-sERROR_ON_UNDEFINED_SYMBOLS=0 -sALLOW_MEMORY_GROWTH=1" \
      -DCMAKE_CXX_FLAGS="-DHAVE_WAIT4=0"

# Build Clang (this takes 30-60 min first time, then cached)
RUN cd build-wasm && ninja clang

# Package output
RUN mkdir -p /build/dist && \
    cp build-wasm/bin/clang.wasm /build/dist/ && \
    gzip -9 -c build-wasm/bin/clang.wasm > /build/dist/clang.wasm.gz

# ==============================================================================
# Stage 3: Custom WASM Code Integration (FAST - rebuilds in seconds/minutes)
# ==============================================================================
FROM llvm-build AS custom-wasm

# This stage is where you'd add your custom WASM modifications
# Copy your modified source files here
# COPY custom-patches/ /build/custom-patches/

# Example: Apply custom patches and rebuild only affected files
# RUN cd build-wasm && \
#     patch -p1 < /build/custom-patches/your-patch.diff && \
#     ninja clang  # Only rebuilds changed files (seconds to minutes)

# For now, just copy the output
RUN mkdir -p /output && \
    cp /build/dist/clang.wasm /output/ && \
    cp /build/dist/clang.wasm.gz /output/

# ==============================================================================
# Stage 4: Final Output (MINIMAL - just the binary)
# ==============================================================================
FROM scratch AS output
COPY --from=custom-wasm /output/ /

# ==============================================================================
# Usage Instructions
# ==============================================================================
#
# 1. First build (caches LLVM):
#    docker build --target llvm-build -t battlewithbytes/llvm-wasm-arm:cached .
#    Result: 30-60 min, creates cached layer
#
# 2. Subsequent builds with custom code:
#    docker build --target custom-wasm -t battlewithbytes/clang-wasm-arm:latest .
#    Result: Seconds to minutes (only rebuilds changed files)
#
# 3. Extract binary:
#    docker build --target output -o dist .
#    Result: Copies clang.wasm and clang.wasm.gz to ./dist/
#
# 4. CI/CD workflow:
#    # Pre-build and push cached base
#    docker build --target llvm-build -t battlewithbytes/llvm-wasm-arm:18.x .
#    docker push battlewithbytes/llvm-wasm-arm:18.x
#
#    # In CI, use cached base
#    FROM battlewithbytes/llvm-wasm-arm:18.x AS llvm-build
#    # ... your custom stage ...
#
# 5. Build for different architectures:
#    docker build --build-arg LLVM_TARGETS=Mips -t clang-wasm-mips .
#    docker build --build-arg LLVM_TARGETS="ARM;Mips;RISCV" -t clang-wasm-multi .
#
