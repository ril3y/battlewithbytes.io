rule CXX_EXECUTABLE_LINKER__opt_MinSizeRel
  command = $PRE_LINK && /emsdk/upstream/emscripten/em++ $FLAGS $LINK_FLAGS $in -o $TARGET_FILE $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX executable $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__Remarks_MinSizeRel
  depfile = $DEP_FILE
  deps = gcc
  command = /emsdk/upstream/emscripten/em++ $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building CXX object $out


#############################################
# Rule for linking CXX static library.

rule CXX_STATIC_LIBRARY_LINKER__Remarks_MinSizeRel
  command = $PRE_LINK && /usr/bin/cmake -E rm -f $TARGET_FILE && /emsdk/upstream/emscripten/emar qc $TARGET_FILE $LINK_FLAGS $in && /emsdk/upstream/emscripten/emranlib $TARGET_FILE && $POST_BUILD
  description = Linking CXX static library $TARGET_FILE
  restat = $RESTAT


