# =============================================================================
# Object build statements for STATIC_LIBRARY target LLVMDemangle


#############################################
# Order-only phony target for LLVMDemangle

build cmake_object_order_depends_target_LLVMDemangle: phony || lib/Demangle/CMakeFiles/LLVMDemangle.dir

build lib/Demangle/CMakeFiles/LLVMDemangle.dir/Demangle.cpp.o: CXX_COMPILER__LLVMDemangle_Release /build/llvm-project/llvm/lib/Demangle/Demangle.cpp || cmake_object_order_depends_target_LLVMDemangle
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = lib/Demangle/CMakeFiles/LLVMDemangle.dir/Demangle.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -O3 -DNDEBUG  -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/build/build-wasm/NATIVE/lib/Demangle -I/build/llvm-project/llvm/lib/Demangle -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = lib/Demangle/CMakeFiles/LLVMDemangle.dir
  OBJECT_FILE_DIR = lib/Demangle/CMakeFiles/LLVMDemangle.dir
  TARGET_COMPILE_PDB = lib/Demangle/CMakeFiles/LLVMDemangle.dir/LLVMDemangle.pdb
  TARGET_PDB = lib/libLLVMDemangle.pdb

