  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -O3 -DNDEBUG
  LINK_FLAGS = -Wl,-rpath-link,/build/build-wasm/NATIVE/./lib  -Wl,--gc-sections
  LINK_LIBRARIES = -Wl,-rpath,"\$$ORIGIN/../lib:"  lib/libLLVMBinaryFormat.a  lib/libLLVMBitReader.a  lib/libLLVMBitWriter.a  lib/libLLVMCore.a  lib/libLLVMIRReader.a  lib/libLLVMLinker.a  lib/libLLVMObject.a  lib/libLLVMSupport.a  lib/libLLVMTransformUtils.a  lib/libLLVMipo.a  lib/libLLVMBitWriter.a  lib/libLLVMLinker.a  lib/libLLVMFrontendOpenMP.a  lib/libLLVMFrontendOffloading.a  lib/libLLVMScalarOpts.a  lib/libLLVMAggressiveInstCombine.a  lib/libLLVMInstCombine.a  lib/libLLVMVectorize.a  lib/libLLVMInstrumentation.a  lib/libLLVMTransformUtils.a  lib/libLLVMAnalysis.a  lib/libLLVMProfileData.a  lib/libLLVMSymbolize.a  lib/libLLVMDebugInfoPDB.a  lib/libLLVMDebugInfoMSF.a  lib/libLLVMDebugInfoBTF.a  lib/libLLVMDebugInfoDWARF.a  lib/libLLVMObject.a  lib/libLLVMIRReader.a  lib/libLLVMBitReader.a  lib/libLLVMAsmParser.a  lib/libLLVMCore.a  lib/libLLVMRemarks.a  lib/libLLVMBitstreamReader.a  lib/libLLVMMCParser.a  lib/libLLVMMC.a  lib/libLLVMDebugInfoCodeView.a  lib/libLLVMTextAPI.a  lib/libLLVMBinaryFormat.a  lib/libLLVMTargetParser.a  lib/libLLVMSupport.a  lib/libLLVMDemangle.a  -lrt  -ldl  -lm
  OBJECT_DIR = tools/llvm-link/CMakeFiles/llvm-link.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/llvm-link/CMakeFiles/llvm-link.dir/
  TARGET_FILE = bin/llvm-link
  TARGET_PDB = bin/llvm-link.pdb


#############################################
# Utility command for install-llvm-link

build tools/llvm-link/install-llvm-link: phony tools/llvm-link/CMakeFiles/install-llvm-link bin/llvm-link


#############################################
# Utility command for install-llvm-link-stripped

build tools/llvm-link/install-llvm-link-stripped: phony tools/llvm-link/CMakeFiles/install-llvm-link-stripped bin/llvm-link


#############################################
# Utility command for package

build tools/llvm-link/CMakeFiles/package.util: CUSTOM_COMMAND tools/llvm-link/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/llvm-link/package: phony tools/llvm-link/CMakeFiles/package.util


#############################################
# Utility command for package_source

build tools/llvm-link/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build tools/llvm-link/package_source: phony tools/llvm-link/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build tools/llvm-link/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/tools/llvm-link && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build tools/llvm-link/edit_cache: phony tools/llvm-link/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tools/llvm-link/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/tools/llvm-link && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools/llvm-link/rebuild_cache: phony tools/llvm-link/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build tools/llvm-link/list_install_components: phony


#############################################
# Utility command for install

build tools/llvm-link/CMakeFiles/install.util: CUSTOM_COMMAND tools/llvm-link/all
  COMMAND = cd /build/build-wasm/NATIVE/tools/llvm-link && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build tools/llvm-link/install: phony tools/llvm-link/CMakeFiles/install.util


#############################################
# Utility command for install/local

build tools/llvm-link/CMakeFiles/install/local.util: CUSTOM_COMMAND tools/llvm-link/all
  COMMAND = cd /build/build-wasm/NATIVE/tools/llvm-link && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build tools/llvm-link/install/local: phony tools/llvm-link/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build tools/llvm-link/CMakeFiles/install/strip.util: CUSTOM_COMMAND tools/llvm-link/all
  COMMAND = cd /build/build-wasm/NATIVE/tools/llvm-link && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build tools/llvm-link/install/strip: phony tools/llvm-link/CMakeFiles/install/strip.util


