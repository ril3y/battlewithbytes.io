  COMMAND = cd /build/build-wasm/NATIVE/lib/Transforms/Hello && /usr/bin/python3.10 -c "import sys;        lines = ['    ' + l.rstrip() for l in sys.stdin] + ['  local: *;'];        print('LLVM_18.1 {');        print('  global:') if len(lines) > 1 else None;        print(';\\n'.join(lines) + '\\n};')" < /build/llvm-project/llvm/lib/Transforms/Hello/Hello.exports > LLVMHello.exports
  DESC = Creating export file for LLVMHello
