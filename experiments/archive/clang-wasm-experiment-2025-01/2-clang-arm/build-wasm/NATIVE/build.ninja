#############################################
# Utility command for package

build lib/LineEditor/CMakeFiles/package.util: CUSTOM_COMMAND lib/LineEditor/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/LineEditor/package: phony lib/LineEditor/CMakeFiles/package.util


