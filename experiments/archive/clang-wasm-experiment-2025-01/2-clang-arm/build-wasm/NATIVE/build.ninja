# =============================================================================
# Write statements declared in CMakeLists.txt:
# /build/llvm-project/clang/lib/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for OBJECT_LIBRARY target obj.clangSupport


#############################################
# Order-only phony target for obj.clangSupport

build cmake_object_order_depends_target_obj.clangSupport: phony || tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir

build tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir/RISCVVIntrinsicUtils.cpp.o: CXX_COMPILER__obj.2eclangSupport_Release /build/llvm-project/clang/lib/Support/RISCVVIntrinsicUtils.cpp || cmake_object_order_depends_target_obj.clangSupport
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir/RISCVVIntrinsicUtils.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -O3 -DNDEBUG  -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/build/build-wasm/NATIVE/tools/clang/lib/Support -I/build/llvm-project/clang/lib/Support -I/build/llvm-project/clang/include -I/build/build-wasm/NATIVE/tools/clang/include -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir
  OBJECT_FILE_DIR = tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir
  TARGET_COMPILE_PDB = tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir/
  TARGET_PDB = ""



#############################################
# Object library obj.clangSupport

build tools/clang/lib/Support/obj.clangSupport: phony tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir/RISCVVIntrinsicUtils.cpp.o

# =============================================================================
# Object build statements for STATIC_LIBRARY target clangSupport


#############################################
# Order-only phony target for clangSupport

build cmake_object_order_depends_target_clangSupport: phony || cmake_object_order_depends_target_LLVMDemangle cmake_object_order_depends_target_LLVMSupport cmake_object_order_depends_target_obj.clangSupport


# =============================================================================
# Link build statements for STATIC_LIBRARY target clangSupport


#############################################
# Link the static library lib/libclangSupport.a

build lib/libclangSupport.a: CXX_STATIC_LIBRARY_LINKER__clangSupport_Release tools/clang/lib/Support/CMakeFiles/obj.clangSupport.dir/RISCVVIntrinsicUtils.cpp.o || lib/libLLVMDemangle.a lib/libLLVMSupport.a tools/clang/lib/Support/obj.clangSupport
  LANGUAGE_COMPILE_FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -O3 -DNDEBUG
  OBJECT_DIR = tools/clang/lib/Support/CMakeFiles/clangSupport.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/clang/lib/Support/CMakeFiles/clangSupport.dir/clangSupport.pdb
  TARGET_FILE = lib/libclangSupport.a
  TARGET_PDB = lib/libclangSupport.pdb


#############################################
# Utility command for install-clangSupport

build tools/clang/lib/Support/install-clangSupport: phony tools/clang/lib/Support/CMakeFiles/install-clangSupport lib/libclangSupport.a


#############################################
# Utility command for install-clangSupport-stripped

build tools/clang/lib/Support/install-clangSupport-stripped: phony tools/clang/lib/Support/CMakeFiles/install-clangSupport-stripped lib/libclangSupport.a


#############################################
# Utility command for package

build tools/clang/lib/Support/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/lib/Support/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/clang/lib/Support/package: phony tools/clang/lib/Support/CMakeFiles/package.util


#############################################
# Utility command for package_source

build tools/clang/lib/Support/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build tools/clang/lib/Support/package_source: phony tools/clang/lib/Support/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build tools/clang/lib/Support/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/tools/clang/lib/Support && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build tools/clang/lib/Support/edit_cache: phony tools/clang/lib/Support/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tools/clang/lib/Support/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/tools/clang/lib/Support && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools/clang/lib/Support/rebuild_cache: phony tools/clang/lib/Support/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build tools/clang/lib/Support/list_install_components: phony


#############################################
# Utility command for install

build tools/clang/lib/Support/CMakeFiles/install.util: CUSTOM_COMMAND tools/clang/lib/Support/all
  COMMAND = cd /build/build-wasm/NATIVE/tools/clang/lib/Support && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build tools/clang/lib/Support/install: phony tools/clang/lib/Support/CMakeFiles/install.util


#############################################
# Utility command for install/local

build tools/clang/lib/Support/CMakeFiles/install/local.util: CUSTOM_COMMAND tools/clang/lib/Support/all
  COMMAND = cd /build/build-wasm/NATIVE/tools/clang/lib/Support && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build tools/clang/lib/Support/install/local: phony tools/clang/lib/Support/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build tools/clang/lib/Support/CMakeFiles/install/strip.util: CUSTOM_COMMAND tools/clang/lib/Support/all
  COMMAND = cd /build/build-wasm/NATIVE/tools/clang/lib/Support && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

