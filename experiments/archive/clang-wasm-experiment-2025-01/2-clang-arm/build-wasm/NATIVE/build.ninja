# =============================================================================
# Write statements declared in CMakeLists.txt:
# /build/llvm-project/clang/lib/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for OBJECT_LIBRARY target obj.clangCodeGen


#############################################
# Order-only phony target for obj.clangCodeGen

build cmake_object_order_depends_target_obj.clangCodeGen: phony || include/llvm/IR/intrinsics_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions

build tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir/ABIInfo.cpp.o: CXX_COMPILER__obj.2eclangCodeGen_Release /build/llvm-project/clang/lib/CodeGen/ABIInfo.cpp || cmake_object_order_depends_target_obj.clangCodeGen
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir/ABIInfo.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -O3 -DNDEBUG  -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/build/build-wasm/NATIVE/tools/clang/lib/CodeGen -I/build/llvm-project/clang/lib/CodeGen -I/build/llvm-project/clang/include -I/build/build-wasm/NATIVE/tools/clang/include -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir
  OBJECT_FILE_DIR = tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir
  TARGET_COMPILE_PDB = tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir/
  TARGET_PDB = ""

build tools/clang/lib/CodeGen/CMakeFiles/obj.clangCodeGen.dir/ABIInfoImpl.cpp.o: CXX_COMPILER__obj.2eclangCodeGen_Release /build/llvm-project/clang/lib/CodeGen/ABIInfoImpl.cpp || cmake_object_order_depends_target_obj.clangCodeGen
