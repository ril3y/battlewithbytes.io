  LINK_FLAGS = -Wl,-z,defs -Wl,-z,nodelete   -Wl,-rpath-link,/build/build-wasm/NATIVE/./lib  -Wl,--gc-sections  -Wl,--version-script,"/build/build-wasm/NATIVE/tools/remarks-shlib/Remarks.exports"
