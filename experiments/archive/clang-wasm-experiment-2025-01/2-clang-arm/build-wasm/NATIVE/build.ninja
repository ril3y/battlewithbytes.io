build lib/MC/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/MC && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

