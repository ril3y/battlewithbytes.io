build lib/ObjCopy/CMakeFiles/install.util: CUSTOM_COMMAND lib/ObjCopy/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/ObjCopy && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/ObjCopy/install: phony lib/ObjCopy/CMakeFiles/install.util


#############################################
