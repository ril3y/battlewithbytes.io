build lib/LineEditor/list_install_components: phony


#############################################
# Utility command for install

build lib/LineEditor/CMakeFiles/install.util: CUSTOM_COMMAND lib/LineEditor/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/LineEditor && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/LineEditor/install: phony lib/LineEditor/CMakeFiles/install.util


