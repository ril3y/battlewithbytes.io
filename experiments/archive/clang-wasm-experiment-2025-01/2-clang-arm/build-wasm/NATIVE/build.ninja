#############################################
# Utility command for package

build lib/Remarks/CMakeFiles/package.util: CUSTOM_COMMAND lib/Remarks/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/Remarks/package: phony lib/Remarks/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/Remarks/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/Remarks/package_source: phony lib/Remarks/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build lib/Remarks/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/Remarks && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build lib/Remarks/edit_cache: phony lib/Remarks/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build lib/Remarks/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/Remarks && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/Remarks/rebuild_cache: phony lib/Remarks/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/Remarks/list_install_components: phony


#############################################
# Utility command for install

build lib/Remarks/CMakeFiles/install.util: CUSTOM_COMMAND lib/Remarks/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Remarks && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/Remarks/install: phony lib/Remarks/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/Remarks/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/Remarks/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Remarks && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/Remarks/install/local: phony lib/Remarks/CMakeFiles/install/local.util


#############################################
