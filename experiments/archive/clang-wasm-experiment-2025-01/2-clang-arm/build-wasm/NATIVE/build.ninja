build lib/Transforms/AggressiveInstCombine/CMakeFiles/install-LLVMAggressiveInstCombine-stripped | ${cmake_ninja_workdir}lib/Transforms/AggressiveInstCombine/CMakeFiles/install-LLVMAggressiveInstCombine-stripped: CUSTOM_COMMAND || bin/llvm-min-tblgen include/llvm/IR/intrinsics_gen include/llvm/Support/llvm_vcsrevision_h include/llvm/TargetParser/RISCVTargetParserTableGen lib/Support/BLAKE3/LLVMSupportBlake3 lib/libLLVMAggressiveInstCombine.a lib/libLLVMAnalysis.a lib/libLLVMAsmParser.a lib/libLLVMBinaryFormat.a lib/libLLVMBitReader.a lib/libLLVMBitstreamReader.a lib/libLLVMCore.a lib/libLLVMDebugInfoBTF.a lib/libLLVMDebugInfoCodeView.a lib/libLLVMDebugInfoDWARF.a lib/libLLVMDebugInfoMSF.a lib/libLLVMDebugInfoPDB.a lib/libLLVMDemangle.a lib/libLLVMIRReader.a lib/libLLVMMC.a lib/libLLVMMCParser.a lib/libLLVMObject.a lib/libLLVMProfileData.a lib/libLLVMRemarks.a lib/libLLVMSupport.a lib/libLLVMSymbolize.a lib/libLLVMTableGen.a lib/libLLVMTargetParser.a lib/libLLVMTextAPI.a lib/libLLVMTransformUtils.a utils/TableGen/obj.LLVMTableGenCommon
  COMMAND = cd /build/build-wasm/NATIVE/lib/Transforms/AggressiveInstCombine && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="LLVMAggressiveInstCombine" -DCMAKE_INSTALL_DO_STRIP=1 -P /build/build-wasm/NATIVE/cmake_install.cmake
  pool = console

