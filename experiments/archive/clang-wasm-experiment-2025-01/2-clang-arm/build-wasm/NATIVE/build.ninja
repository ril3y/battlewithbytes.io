# =============================================================================
# Object build statements for OBJECT_LIBRARY target obj.clangDriver


#############################################
# Order-only phony target for obj.clangDriver

build cmake_object_order_depends_target_obj.clangDriver: phony || tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions

build tools/clang/lib/Driver/CMakeFiles/obj.clangDriver.dir/Action.cpp.o: CXX_COMPILER__obj.2eclangDriver_Release /build/llvm-project/clang/lib/Driver/Action.cpp || cmake_object_order_depends_target_obj.clangDriver
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/lib/Driver/CMakeFiles/obj.clangDriver.dir/Action.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -O3 -DNDEBUG  -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/build/build-wasm/NATIVE/tools/clang/lib/Driver -I/build/llvm-project/clang/lib/Driver -I/build/llvm-project/clang/include -I/build/build-wasm/NATIVE/tools/clang/include -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = tools/clang/lib/Driver/CMakeFiles/obj.clangDriver.dir
  OBJECT_FILE_DIR = tools/clang/lib/Driver/CMakeFiles/obj.clangDriver.dir
  TARGET_COMPILE_PDB = tools/clang/lib/Driver/CMakeFiles/obj.clangDriver.dir/
  TARGET_PDB = ""

