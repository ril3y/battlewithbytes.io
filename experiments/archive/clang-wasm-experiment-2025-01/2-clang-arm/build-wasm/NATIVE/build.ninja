# Utility command for package

build lib/Transforms/IPO/CMakeFiles/package.util: CUSTOM_COMMAND lib/Transforms/IPO/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/Transforms/IPO/package: phony lib/Transforms/IPO/CMakeFiles/package.util


#############################################
