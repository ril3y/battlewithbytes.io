#############################################
# Create executable symlink bin/clang

build bin/clang: CMAKE_SYMLINK_EXECUTABLE bin/clang-18
  POST_BUILD = cd /build/build-wasm/NATIVE/tools/clang/tools/driver && /usr/bin/cmake -E create_symlink clang-18 /build/build-wasm/NATIVE/./bin/clang++ && cd /build/build-wasm/NATIVE/tools/clang/tools/driver && /usr/bin/cmake -E create_symlink clang-18 /build/build-wasm/NATIVE/./bin/clang-cl && cd /build/build-wasm/NATIVE/tools/clang/tools/driver && /usr/bin/cmake -E create_symlink clang-18 /build/build-wasm/NATIVE/./bin/clang-cpp


