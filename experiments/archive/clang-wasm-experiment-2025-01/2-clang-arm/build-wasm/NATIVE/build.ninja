build tools/clang/examples/Attribute/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/examples/Attribute/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
