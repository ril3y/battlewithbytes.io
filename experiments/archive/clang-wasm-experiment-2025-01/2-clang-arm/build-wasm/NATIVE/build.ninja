build lib/MC/install-LLVMMC-stripped: phony lib/MC/CMakeFiles/install-LLVMMC-stripped lib/libLLVMMC.a


#############################################
# Utility command for package

build lib/MC/CMakeFiles/package.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/MC/package: phony lib/MC/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/MC/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/MC/package_source: phony lib/MC/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build lib/MC/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/MC && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build lib/MC/edit_cache: phony lib/MC/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build lib/MC/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/MC && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/MC/rebuild_cache: phony lib/MC/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/MC/list_install_components: phony


#############################################
# Utility command for install

build lib/MC/CMakeFiles/install.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/MC && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/MC/install: phony lib/MC/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/MC/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/MC/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/MC && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/MC/install/local: phony lib/MC/CMakeFiles/install/local.util


