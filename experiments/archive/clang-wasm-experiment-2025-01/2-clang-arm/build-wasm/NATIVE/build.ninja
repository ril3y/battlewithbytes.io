build lib/TargetParser/install-LLVMTargetParser-stripped: phony lib/TargetParser/CMakeFiles/install-LLVMTargetParser-stripped lib/libLLVMTargetParser.a


#############################################
# Utility command for package

build lib/TargetParser/CMakeFiles/package.util: CUSTOM_COMMAND lib/TargetParser/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/TargetParser/package: phony lib/TargetParser/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/TargetParser/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/TargetParser/package_source: phony lib/TargetParser/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build lib/TargetParser/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/TargetParser && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build lib/TargetParser/edit_cache: phony lib/TargetParser/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build lib/TargetParser/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/TargetParser && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/TargetParser/rebuild_cache: phony lib/TargetParser/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/TargetParser/list_install_components: phony


#############################################
# Utility command for install

build lib/TargetParser/CMakeFiles/install.util: CUSTOM_COMMAND lib/TargetParser/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/TargetParser && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/TargetParser/install: phony lib/TargetParser/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/TargetParser/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/TargetParser/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/TargetParser && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/TargetParser/install/local: phony lib/TargetParser/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build lib/TargetParser/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/TargetParser/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/TargetParser && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build lib/TargetParser/install/strip: phony lib/TargetParser/CMakeFiles/install/strip.util


