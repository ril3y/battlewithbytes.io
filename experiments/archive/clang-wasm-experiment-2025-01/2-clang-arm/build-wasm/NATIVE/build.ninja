build lib/Support/BLAKE3/CMakeFiles/install.util: CUSTOM_COMMAND lib/Support/BLAKE3/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Support/BLAKE3 && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/Support/BLAKE3/install: phony lib/Support/BLAKE3/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/Support/BLAKE3/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/Support/BLAKE3/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Support/BLAKE3 && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
