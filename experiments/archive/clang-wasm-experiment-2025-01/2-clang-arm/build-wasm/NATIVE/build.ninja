build lib/LineEditor/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/LineEditor && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build lib/LineEditor/edit_cache: phony lib/LineEditor/CMakeFiles/edit_cache.util


