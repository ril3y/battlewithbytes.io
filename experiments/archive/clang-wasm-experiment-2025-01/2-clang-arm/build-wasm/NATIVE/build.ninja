#############################################
# Order-only phony target for obj.clangInterpreter

build cmake_object_order_depends_target_obj.clangInterpreter: phony || include/llvm/IR/intrinsics_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions

build tools/clang/lib/Interpreter/CMakeFiles/obj.clangInterpreter.dir/DeviceOffload.cpp.o: CXX_COMPILER__obj.2eclangInterpreter_Release /build/llvm-project/clang/lib/Interpreter/DeviceOffload.cpp || cmake_object_order_depends_target_obj.clangInterpreter
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
