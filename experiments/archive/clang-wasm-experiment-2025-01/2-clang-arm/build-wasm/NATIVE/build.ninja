  INCLUDES = -I/build/build-wasm/NATIVE/tools/clang/tools/clang-fuzzer/handle-llvm -I/build/llvm-project/clang/tools/clang-fuzzer/handle-llvm -I/build/llvm-project/clang/include -I/build/build-wasm/NATIVE/tools/clang/include -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = tools/clang/tools/clang-fuzzer/handle-llvm/CMakeFiles/obj.clangHandleLLVM.dir
