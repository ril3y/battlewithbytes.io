build lib/TargetParser/CMakeFiles/install-LLVMTargetParser | ${cmake_ninja_workdir}lib/TargetParser/CMakeFiles/install-LLVMTargetParser: CUSTOM_COMMAND || bin/llvm-min-tblgen include/llvm/TargetParser/RISCVTargetParserTableGen lib/Support/BLAKE3/LLVMSupportBlake3 lib/libLLVMDemangle.a lib/libLLVMSupport.a lib/libLLVMTableGen.a lib/libLLVMTargetParser.a utils/TableGen/obj.LLVMTableGenCommon
  COMMAND = cd /build/build-wasm/NATIVE/lib/TargetParser && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="LLVMTargetParser" -P /build/build-wasm/NATIVE/cmake_install.cmake
  pool = console


