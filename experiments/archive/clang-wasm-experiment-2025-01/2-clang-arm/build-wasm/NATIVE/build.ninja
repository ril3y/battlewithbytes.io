build tools/clang/tools/driver/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/tools/driver/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/clang/tools/driver/package: phony tools/clang/tools/driver/CMakeFiles/package.util


