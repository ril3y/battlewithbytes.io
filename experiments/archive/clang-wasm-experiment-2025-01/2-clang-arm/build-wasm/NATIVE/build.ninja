  COMMAND = cd /build/build-wasm/NATIVE/lib/ObjCopy && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/ObjCopy/rebuild_cache: phony lib/ObjCopy/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/ObjCopy/list_install_components: phony


#############################################
