#############################################
# Utility command for package

build tools/llvm-dwp/CMakeFiles/package.util: CUSTOM_COMMAND tools/llvm-dwp/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/llvm-dwp/package: phony tools/llvm-dwp/CMakeFiles/package.util


#############################################
