  OBJECT_DIR = tools/clang/tools/apinotes-test/CMakeFiles/apinotes-test.dir
  OBJECT_FILE_DIR = tools/clang/tools/apinotes-test/CMakeFiles/apinotes-test.dir
  TARGET_COMPILE_PDB = tools/clang/tools/apinotes-test/CMakeFiles/apinotes-test.dir/
