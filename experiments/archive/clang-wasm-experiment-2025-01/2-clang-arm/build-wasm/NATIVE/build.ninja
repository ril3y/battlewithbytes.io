# Object build statements for EXECUTABLE target llvm-objdump


#############################################
# Order-only phony target for llvm-objdump

build cmake_object_order_depends_target_llvm-objdump: phony || cmake_object_order_depends_target_LLVMARMDesc cmake_object_order_depends_target_LLVMARMDisassembler cmake_object_order_depends_target_LLVMARMInfo cmake_object_order_depends_target_LLVMARMUtils cmake_object_order_depends_target_LLVMAsmParser cmake_object_order_depends_target_LLVMBinaryFormat cmake_object_order_depends_target_LLVMBitReader cmake_object_order_depends_target_LLVMBitstreamReader cmake_object_order_depends_target_LLVMCodeGenTypes cmake_object_order_depends_target_LLVMCore cmake_object_order_depends_target_LLVMDebugInfoBTF cmake_object_order_depends_target_LLVMDebugInfoCodeView cmake_object_order_depends_target_LLVMDebugInfoDWARF cmake_object_order_depends_target_LLVMDebugInfoMSF cmake_object_order_depends_target_LLVMDebugInfoPDB cmake_object_order_depends_target_LLVMDebuginfod cmake_object_order_depends_target_LLVMDemangle cmake_object_order_depends_target_LLVMIRReader cmake_object_order_depends_target_LLVMMC cmake_object_order_depends_target_LLVMMCDisassembler cmake_object_order_depends_target_LLVMMCParser cmake_object_order_depends_target_LLVMObject cmake_object_order_depends_target_LLVMOption cmake_object_order_depends_target_LLVMRemarks cmake_object_order_depends_target_LLVMSupport cmake_object_order_depends_target_LLVMSymbolize cmake_object_order_depends_target_LLVMTargetParser cmake_object_order_depends_target_LLVMTextAPI tools/llvm-objdump/ObjdumpOptsTableGen tools/llvm-objdump/OtoolOptsTableGen

build tools/llvm-objdump/CMakeFiles/llvm-objdump.dir/llvm-objdump.cpp.o: CXX_COMPILER__llvm-objdump_Release /build/llvm-project/llvm/tools/llvm-objdump/llvm-objdump.cpp || cmake_object_order_depends_target_llvm-objdump
