# =============================================================================
# Object build statements for MODULE_LIBRARY target Attribute


#############################################
# Order-only phony target for Attribute

build cmake_object_order_depends_target_Attribute: phony || tools/clang/clang-tablegen-targets

build tools/clang/examples/Attribute/CMakeFiles/Attribute.dir/Attribute.cpp.o: CXX_COMPILER__Attribute_Release /build/llvm-project/clang/examples/Attribute/Attribute.cpp || cmake_object_order_depends_target_Attribute
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/examples/Attribute/CMakeFiles/Attribute.dir/Attribute.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -O3 -DNDEBUG -fPIC  -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/build/build-wasm/NATIVE/tools/clang/examples/Attribute -I/build/llvm-project/clang/examples/Attribute -I/build/llvm-project/clang/include -I/build/build-wasm/NATIVE/tools/clang/include -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = tools/clang/examples/Attribute/CMakeFiles/Attribute.dir
  OBJECT_FILE_DIR = tools/clang/examples/Attribute/CMakeFiles/Attribute.dir
  TARGET_COMPILE_PDB = tools/clang/examples/Attribute/CMakeFiles/Attribute.dir/
  TARGET_PDB = lib/Attribute.pdb


# =============================================================================
# Link build statements for MODULE_LIBRARY target Attribute


#############################################
# Link the shared module lib/Attribute.so

build lib/Attribute.so: CXX_MODULE_LIBRARY_LINKER__Attribute_Release tools/clang/examples/Attribute/CMakeFiles/Attribute.dir/Attribute.cpp.o || tools/clang/clang-tablegen-targets
  LANGUAGE_COMPILE_FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -O3 -DNDEBUG
  LINK_FLAGS = -Wl,-z,nodelete   -Wl,-rpath-link,/build/build-wasm/NATIVE/./lib  -Wl,--gc-sections
  LINK_LIBRARIES = -Wl,-rpath,"\$$ORIGIN/../lib"
  OBJECT_DIR = tools/clang/examples/Attribute/CMakeFiles/Attribute.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/clang/examples/Attribute/CMakeFiles/Attribute.dir/
  TARGET_FILE = lib/Attribute.so
  TARGET_PDB = lib/Attribute.pdb


#############################################
