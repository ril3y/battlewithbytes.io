  COMMAND = cd /build/build-wasm/NATIVE/lib/Transforms/Utils && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/Transforms/Utils/install: phony lib/Transforms/Utils/CMakeFiles/install.util


