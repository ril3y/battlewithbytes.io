  OBJECT_DIR = tools/clang/lib/Index/CMakeFiles/clangIndex.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/clang/lib/Index/CMakeFiles/clangIndex.dir/clangIndex.pdb
