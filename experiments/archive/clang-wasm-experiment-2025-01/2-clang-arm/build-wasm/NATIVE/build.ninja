# =============================================================================
# Object build statements for EXECUTABLE target llvm-config


#############################################
# Order-only phony target for llvm-config

build cmake_object_order_depends_target_llvm-config: phony || cmake_object_order_depends_target_LLVMDemangle cmake_object_order_depends_target_LLVMSupport cmake_object_order_depends_target_LLVMTargetParser

build tools/llvm-config/CMakeFiles/llvm-config.dir/llvm-config.cpp.o: CXX_COMPILER__llvm-config_Release /build/llvm-project/llvm/tools/llvm-config/llvm-config.cpp | tools/llvm-config/BuildVariables.inc || cmake_object_order_depends_target_llvm-config
  DEFINES = -DCMAKE_CFG_INTDIR=\"Release\" -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/llvm-config/CMakeFiles/llvm-config.dir/llvm-config.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -O3 -DNDEBUG  -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/build/build-wasm/NATIVE/tools/llvm-config -I/build/llvm-project/llvm/tools/llvm-config -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = tools/llvm-config/CMakeFiles/llvm-config.dir
  OBJECT_FILE_DIR = tools/llvm-config/CMakeFiles/llvm-config.dir
  TARGET_COMPILE_PDB = tools/llvm-config/CMakeFiles/llvm-config.dir/
  TARGET_PDB = bin/llvm-config.pdb


# =============================================================================
# Link build statements for EXECUTABLE target llvm-config


#############################################
# Link the executable bin/llvm-config

build bin/llvm-config: CXX_EXECUTABLE_LINKER__llvm-config_Release tools/llvm-config/CMakeFiles/llvm-config.dir/llvm-config.cpp.o | lib/libLLVMSupport.a lib/libLLVMTargetParser.a lib/libLLVMSupport.a lib/libLLVMDemangle.a || lib/libLLVMDemangle.a lib/libLLVMSupport.a lib/libLLVMTargetParser.a
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -O3 -DNDEBUG
  LINK_FLAGS = -Wl,-rpath-link,/build/build-wasm/NATIVE/./lib  -Wl,--gc-sections
  LINK_LIBRARIES = -Wl,-rpath,"\$$ORIGIN/../lib:"  lib/libLLVMSupport.a  lib/libLLVMTargetParser.a  lib/libLLVMSupport.a  -lrt  -ldl  -lm  lib/libLLVMDemangle.a
  OBJECT_DIR = tools/llvm-config/CMakeFiles/llvm-config.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/llvm-config/CMakeFiles/llvm-config.dir/
  TARGET_FILE = bin/llvm-config
  TARGET_PDB = bin/llvm-config.pdb


