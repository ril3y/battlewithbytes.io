#############################################
# Utility command for install-LLVMAnalysis

build lib/Analysis/install-LLVMAnalysis: phony lib/Analysis/CMakeFiles/install-LLVMAnalysis lib/libLLVMAnalysis.a


#############################################
# Utility command for install-LLVMAnalysis-stripped

build lib/Analysis/install-LLVMAnalysis-stripped: phony lib/Analysis/CMakeFiles/install-LLVMAnalysis-stripped lib/libLLVMAnalysis.a


#############################################
# Utility command for package

build lib/Analysis/CMakeFiles/package.util: CUSTOM_COMMAND lib/Analysis/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/Analysis/package: phony lib/Analysis/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/Analysis/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/Analysis/package_source: phony lib/Analysis/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build lib/Analysis/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/Analysis && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build lib/Analysis/edit_cache: phony lib/Analysis/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build lib/Analysis/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/Analysis && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/Analysis/rebuild_cache: phony lib/Analysis/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/Analysis/list_install_components: phony


#############################################
# Utility command for install

build lib/Analysis/CMakeFiles/install.util: CUSTOM_COMMAND lib/Analysis/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Analysis && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/Analysis/install: phony lib/Analysis/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/Analysis/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/Analysis/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Analysis && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/Analysis/install/local: phony lib/Analysis/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build lib/Analysis/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/Analysis/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Analysis && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build lib/Analysis/install/strip: phony lib/Analysis/CMakeFiles/install/strip.util


