build lib/Remarks/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/Remarks/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/Remarks && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
