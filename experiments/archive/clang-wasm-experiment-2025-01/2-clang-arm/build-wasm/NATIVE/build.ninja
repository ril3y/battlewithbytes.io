  restat = 1

build lib/MCA/package: phony lib/MCA/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/MCA/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/MCA/package_source: phony lib/MCA/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build lib/MCA/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/MCA && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build lib/MCA/edit_cache: phony lib/MCA/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build lib/MCA/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/lib/MCA && /usr/bin/cmake --regenerate-during-build -S/build/llvm-project/llvm -B/build/build-wasm/NATIVE
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build lib/MCA/rebuild_cache: phony lib/MCA/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build lib/MCA/list_install_components: phony


#############################################
# Utility command for install

build lib/MCA/CMakeFiles/install.util: CUSTOM_COMMAND lib/MCA/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/MCA && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build lib/MCA/install: phony lib/MCA/CMakeFiles/install.util


#############################################
# Utility command for install/local

build lib/MCA/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/MCA/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/MCA && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/MCA/install/local: phony lib/MCA/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build lib/MCA/CMakeFiles/install/strip.util: CUSTOM_COMMAND lib/MCA/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/MCA && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build lib/MCA/install/strip: phony lib/MCA/CMakeFiles/install/strip.util


#############################################
# Custom command for lib/MCA/CMakeFiles/install-LLVMMCA

build lib/MCA/CMakeFiles/install-LLVMMCA | ${cmake_ninja_workdir}lib/MCA/CMakeFiles/install-LLVMMCA: CUSTOM_COMMAND || bin/llvm-min-tblgen include/llvm/IR/intrinsics_gen include/llvm/TargetParser/RISCVTargetParserTableGen lib/Support/BLAKE3/LLVMSupportBlake3 lib/libLLVMBinaryFormat.a lib/libLLVMDebugInfoCodeView.a lib/libLLVMDemangle.a lib/libLLVMMC.a lib/libLLVMMCA.a lib/libLLVMSupport.a lib/libLLVMTableGen.a lib/libLLVMTargetParser.a utils/TableGen/obj.LLVMTableGenCommon
  COMMAND = cd /build/build-wasm/NATIVE/lib/MCA && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="LLVMMCA" -P /build/build-wasm/NATIVE/cmake_install.cmake
  pool = console


#############################################
# Custom command for lib/MCA/CMakeFiles/install-LLVMMCA-stripped

build lib/MCA/CMakeFiles/install-LLVMMCA-stripped | ${cmake_ninja_workdir}lib/MCA/CMakeFiles/install-LLVMMCA-stripped: CUSTOM_COMMAND || bin/llvm-min-tblgen include/llvm/IR/intrinsics_gen include/llvm/TargetParser/RISCVTargetParserTableGen lib/Support/BLAKE3/LLVMSupportBlake3 lib/libLLVMBinaryFormat.a lib/libLLVMDebugInfoCodeView.a lib/libLLVMDemangle.a lib/libLLVMMC.a lib/libLLVMMCA.a lib/libLLVMSupport.a lib/libLLVMTableGen.a lib/libLLVMTargetParser.a utils/TableGen/obj.LLVMTableGenCommon
  COMMAND = cd /build/build-wasm/NATIVE/lib/MCA && /usr/bin/cmake -DCMAKE_INSTALL_COMPONENT="LLVMMCA" -DCMAKE_INSTALL_DO_STRIP=1 -P /build/build-wasm/NATIVE/cmake_install.cmake
  pool = console

