build lib/Support/BLAKE3/CMakeFiles/package.util: CUSTOM_COMMAND lib/Support/BLAKE3/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build lib/Support/BLAKE3/package: phony lib/Support/BLAKE3/CMakeFiles/package.util


#############################################
# Utility command for package_source

build lib/Support/BLAKE3/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build lib/Support/BLAKE3/package_source: phony lib/Support/BLAKE3/CMakeFiles/package_source.util


#############################################
