build lib/LineEditor/CMakeFiles/install/local.util: CUSTOM_COMMAND lib/LineEditor/all
  COMMAND = cd /build/build-wasm/NATIVE/lib/LineEditor && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build lib/LineEditor/install/local: phony lib/LineEditor/CMakeFiles/install/local.util


