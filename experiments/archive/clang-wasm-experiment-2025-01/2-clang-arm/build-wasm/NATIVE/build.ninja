build tools/clang/tools/driver/CMakeFiles/clang.dir/driver.cpp.o: CXX_COMPILER__clang_Release /build/llvm-project/clang/tools/driver/driver.cpp || cmake_object_order_depends_target_clang
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  DEP_FILE = tools/clang/tools/driver/CMakeFiles/clang.dir/driver.cpp.o.d
  FLAGS = -fPIC -fno-semantic-interposition -fvisibility-inlines-hidden -Werror=date-time -fno-lifetime-dse -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wcast-qual -Wno-missing-field-initializers -pedantic -Wno-long-long -Wimplicit-fallthrough -Wno-uninitialized -Wno-nonnull -Wno-class-memaccess -Wno-redundant-move -Wno-pessimizing-move -Wno-noexcept-type -Wdelete-non-virtual-dtor -Wsuggest-override -Wno-comment -Wno-misleading-indentation -Wctad-maybe-unsupported -fdiagnostics-color -ffunction-sections -fdata-sections -fno-common -Woverloaded-virtual -fno-strict-aliasing -O3 -DNDEBUG  -fno-exceptions -funwind-tables -fno-rtti -std=c++17
  INCLUDES = -I/build/build-wasm/NATIVE/tools/clang/tools/driver -I/build/llvm-project/clang/tools/driver -I/build/llvm-project/clang/include -I/build/build-wasm/NATIVE/tools/clang/include -I/build/build-wasm/NATIVE/include -I/build/llvm-project/llvm/include
  OBJECT_DIR = tools/clang/tools/driver/CMakeFiles/clang.dir
  OBJECT_FILE_DIR = tools/clang/tools/driver/CMakeFiles/clang.dir
  TARGET_COMPILE_PDB = tools/clang/tools/driver/CMakeFiles/clang.dir/
  TARGET_PDB = bin/clang.pdb

