#############################################
# Utility command for install-clangCodeGen-stripped

build tools/clang/lib/CodeGen/install-clangCodeGen-stripped: phony tools/clang/lib/CodeGen/CMakeFiles/install-clangCodeGen-stripped lib/libclangCodeGen.a


#############################################
# Utility command for package

build tools/clang/lib/CodeGen/CMakeFiles/package.util: CUSTOM_COMMAND tools/clang/lib/CodeGen/all
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build tools/clang/lib/CodeGen/package: phony tools/clang/lib/CodeGen/CMakeFiles/package.util


#############################################
# Utility command for package_source

build tools/clang/lib/CodeGen/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE && /usr/bin/cpack --config ./CPackSourceConfig.cmake /build/build-wasm/NATIVE/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build tools/clang/lib/CodeGen/package_source: phony tools/clang/lib/CodeGen/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build tools/clang/lib/CodeGen/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/build-wasm/NATIVE/tools/clang/lib/CodeGen && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

