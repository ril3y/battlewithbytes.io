#############################################
# Order-only phony target for obj.clangBasic

build cmake_object_order_depends_target_obj.clangBasic: phony || include/llvm/Frontend/OpenMP/omp_gen tools/clang/clang-tablegen-targets tools/clang/include/clang/Driver/ClangDriverOptions tools/clang/lib/Basic/VCSVersion.inc

build tools/clang/lib/Basic/CMakeFiles/obj.clangBasic.dir/Attributes.cpp.o: CXX_COMPILER__obj.2eclangBasic_Release /build/llvm-project/clang/lib/Basic/Attributes.cpp || cmake_object_order_depends_target_obj.clangBasic
  DEFINES = -DGTEST_HAS_RTTI=0 -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
