{
  "name": "@battlewithbytes/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "BattleWithBytes.io monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:wasm": "turbo run build:wasm",
    "test": "turbo run test",
    "test:rust": "turbo run test:rust",
    "lint": "turbo run lint",
    "lint:rust": "turbo run lint:rust",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:rust": "cargo fmt --all",
    "build:web": "turbo run build --filter=@battlewithbytes/web",
    "build:battleterm": "turbo run build --filter=@battlewithbytes/battleterm",
    "build:battlemagic-core": "turbo run build:wasm --filter=@battlewithbytes/battlemagic-core",
    "dev:battlemagic": "turbo run dev --filter=@battlewithbytes/battlemagic-core --filter=@battlewithbytes/battlemagic-ui"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "prettier": "^3.1.1",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=8.6.2"
  },
  "packageManager": "pnpm@9.14.4"
}
